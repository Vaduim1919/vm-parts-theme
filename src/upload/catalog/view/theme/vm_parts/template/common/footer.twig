<nav class="vm-bottomnav" aria-label="{{ vm_t.text_menu }}">
  <a href="{{ vm_home }}"><i class="fa fa-home"></i><span>{{ vm_t.text_home }}</span></a>
  <button type="button" onclick="vmDrawer(true)"><i class="fa fa-th-large"></i><span>{{ vm_t.text_catalog_btn }}</span></button>
  <button type="button" onclick="vmSearch()"><i class="fa fa-search"></i><span>{{ vm_t.text_search_btn }}</span></button>
  <a href="{{ vm_cart_link }}" class="vm-bn-cart"><i class="fa fa-shopping-cart"></i><b id="vm-bn-count"{% if not vm_cart_count %} hidden{% endif %}>{{ vm_cart_count }}</b><span>{{ vm_t.text_cart }}</span></a>
  <button type="button" onclick="document.getElementById('vm-fab').classList.toggle('is-open')"><i class="fa fa-comments"></i><span>{{ vm_t.text_chat }}</span></button>
</nav>
<footer class="vm-footer">
  <div class="container vm-footer-grid">
    <div class="vm-footer-brand">
      <div class="vm-footer-name">{{ vm_name }}</div>
      {% if vm.phone %}<a class="vm-footer-phone" href="{{ vm.phone_href }}">{{ vm.phone }}</a>{% endif %}
      {% if vm.phone2 %}<a class="vm-footer-phone" href="{{ vm.phone2_href }}">{{ vm.phone2 }}</a>{% endif %}
      {% if vm_open %}<div>{{ vm_open }}</div>{% endif %}
      {% if vm_address %}<div>{{ vm_address }}</div>{% endif %}
    </div>
    {% if informations %}
    <div>
      <h5 class="vm-acc">{{ vm_t.text_info }}</h5>
      <ul class="list-unstyled">
        {% for information in informations %}<li><a href="{{ information.href }}">{{ information.title }}</a></li>{% endfor %}
        <li><a href="{{ contact }}">{{ text_contact }}</a></li>
        <li><a href="{{ return }}">{{ text_return }}</a></li>
      </ul>
    </div>
    {% endif %}
    <div>
      <h5 class="vm-acc">{{ vm_t.text_catalog }}</h5>
      <ul class="list-unstyled">
        {% for cat in vm_menu|slice(0, 7) %}<li><a href="{{ cat.href }}">{{ cat.name }}</a></li>{% endfor %}
        <li><a href="{{ special }}">{{ text_special }}</a></li>
      </ul>
    </div>
    <div>
      <h5 class="vm-acc">{{ vm_t.text_cabinet }}</h5>
      <ul class="list-unstyled">
        <li><a href="{{ account }}">{{ text_account }}</a></li>
        <li><a href="{{ order }}">{{ text_order }}</a></li>
        <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
        <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
      </ul>
      {% if vm.instagram or vm.facebook or vm.telegram or vm.viber %}
      <h5 class="vm-footer-social-title">{{ vm_t.text_social }}</h5>
      <div class="vm-footer-social">
        {% if vm.instagram %}<a href="{{ vm.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa fa-instagram"></i></a>{% endif %}
        {% if vm.facebook %}<a href="{{ vm.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa fa-facebook"></i></a>{% endif %}
        {% if vm.telegram %}<a href="{{ vm.telegram }}" target="_blank" rel="noopener" aria-label="Telegram"><i class="fa fa-paper-plane"></i></a>{% endif %}
        {% if vm.viber %}<a href="{{ vm.viber }}" aria-label="Viber"><i class="fa fa-phone"></i></a>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
  <div class="vm-footer-bottom">
    <div class="container vm-row">
      <span>{{ vm_name }} © {{ vm.year }}</span>
      <span>{{ vm_t.text_payments }}</span>
    </div>
  </div>
</footer>
{% if vm.viber or vm.telegram or vm.phone %}
<div class="vm-fab" id="vm-fab">
  <div class="vm-fab-menu">
    {% if vm.viber %}<a href="{{ vm.viber }}" class="vm-fab-viber"><i class="fa fa-phone"></i> Viber</a>{% endif %}
    {% if vm.telegram %}<a href="{{ vm.telegram }}" class="vm-fab-tg" target="_blank" rel="noopener"><i class="fa fa-paper-plane"></i> Telegram</a>{% endif %}
    {% if vm.phone %}<a href="{{ vm.phone_href }}" class="vm-fab-call"><i class="fa fa-phone"></i> {{ vm.phone }}</a>{% endif %}
  </div>
  <button type="button" class="vm-fab-btn" aria-label="{{ vm_t.text_write_us }}" onclick="document.getElementById('vm-fab').classList.toggle('is-open')"><i class="fa fa-comments"></i></button>
</div>
{% endif %}
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script>
function vmDrawer(open){
  var d=document.getElementById('vm-drawer'),o=document.getElementById('vm-drawer-overlay');
  if(!d)return;
  d.classList.toggle('is-open',open);o.classList.toggle('is-open',open);
  d.setAttribute('aria-hidden',open?'false':'true');
  document.documentElement.classList.toggle('vm-noscroll',open);
}
function vmSearch(){
  var i=document.querySelector('#search input[name="search"]');
  if(!i)return;
  window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(function(){i.focus();},250);
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')vmDrawer(false);});
(function(){
  // footer sections fold on phones
  [].forEach.call(document.querySelectorAll('.vm-footer h5.vm-acc'),function(h){
    h.addEventListener('click',function(){if(window.innerWidth<768)h.parentNode.classList.toggle('is-open');});
  });
  // bottom bar cart counter follows the standard add-to-cart AJAX
  if(window.jQuery){
    jQuery(document).ajaxSuccess(function(e,xhr,opt){
      if(!opt||!opt.url||!/checkout\/cart\/(add|remove)/.test(opt.url))return;
      if(/vm_theme\/count/.test(opt.url))return;
      jQuery.getJSON('index.php?route=extension/module/vm_theme/count',function(j){
        var n=parseInt(j.count,10)||0,b=document.getElementById('vm-bn-count');
        if(b){b.textContent=n;if(n>0){b.removeAttribute('hidden');}else{b.setAttribute('hidden','');}}
      });
    });
  }
})();
(function(){
  var d=document.querySelector('.vm-catalog-drop:not(.vm-catalog-drop-home)');
  if(d){d.querySelector('.vm-catalog-btn').addEventListener('click',function(e){e.stopPropagation();d.classList.toggle('is-open');});document.addEventListener('click',function(e){if(!d.contains(e.target))d.classList.remove('is-open');});}
})();
</script>
</body></html>
