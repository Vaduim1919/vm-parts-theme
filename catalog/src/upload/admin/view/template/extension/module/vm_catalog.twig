{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for b in breadcrumbs %}<li><a href="{{ b.href }}">{{ b.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if vm_catalog_error %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ vm_catalog_error }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    {% if not stock_checkout %}
    <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_checkout_off }}
      <form action="{{ checkout_action }}" method="post" style="display:inline;margin-left:10px"><button type="submit" class="btn btn-warning btn-xs">{{ button_checkout_on }}</button></form>
    </div>
    {% endif %}

    <!-- BM Parts API -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_bm_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_bm_help }}</p>
        <form action="{{ utr_save }}" method="post" class="form-horizontal" autocomplete="off">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_bm_photos }}</label><div class="col-sm-6"><select name="module_vm_catalog_bm_photos" class="form-control">
            <option value="local"{% if module_vm_catalog_bm_photos == 'local' %} selected{% endif %}>{{ text_photos_local }}</option>
            <option value="all"{% if module_vm_catalog_bm_photos == 'all' %} selected{% endif %}>{{ text_photos_all }}</option>
            <option value="none"{% if module_vm_catalog_bm_photos == 'none' %} selected{% endif %}>{{ text_photos_none }}</option>
          </select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_bm_token }}</label><div class="col-sm-6"><input type="password" name="module_vm_catalog_bm_token" value="" placeholder="{% if bm_token_set %}{{ text_utr_password_set }}{% endif %}" class="form-control" autocomplete="new-password"></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-default"><i class="fa fa-save"></i> {{ button_save }}</button>
            <input type="text" id="vm-bm-q" class="form-control" placeholder="{{ text_bm_q }}" style="display:inline-block;width:200px;vertical-align:middle">
            <button type="button" id="vm-bm-probe" class="btn btn-info"><i class="fa fa-stethoscope"></i> {{ button_utr_probe }}</button>
          </div></div>
        </form>
        <div id="vm-bm-result" style="max-width:1000px"></div>
        <hr>
        <h4>{{ text_enrich_title }}</h4>
        <p>{{ text_enrich_help }}</p>
        <table class="table table-condensed table-bordered" id="vm-enrich-stats" style="max-width:760px">
          <tr><th>{{ text_en_checked }}</th><th>{{ text_en_found }}</th><th>{{ text_en_notfound }}</th><th>{{ text_en_errors }}</th><th>{{ text_en_cars }}</th><th>{{ text_en_analogs }}</th><th>{{ text_en_photos }}</th></tr>
          <tr><td data-k="checked_total">{{ enrich_stats.checked }} / {{ enrich_stats.total }}</td><td data-k="found">{{ enrich_stats.found }}</td><td data-k="notfound">{{ enrich_stats.notfound }}</td><td data-k="errors">{{ enrich_stats.errors }}</td><td data-k="cars">{{ enrich_stats.with_cars }} <small class="text-muted">({{ enrich_stats.models }} {{ text_en_models }})</small></td><td data-k="with_analogs">{{ enrich_stats.with_analogs }}</td><td data-k="images">{{ enrich_stats.images }}</td></tr>
        </table>
        <div id="vm-img-error" class="alert alert-warning" style="max-width:1000px;word-break:break-all{% if not enrich_stats.img_error %};display:none{% endif %}"><b>{{ text_img_error }}</b> <span>{{ enrich_stats.img_error }}</span></div>
        <p>
          <button type="button" id="vm-enrich-go" class="btn btn-success"><i class="fa fa-play"></i> {{ button_enrich_go }}</button>
          <button type="button" id="vm-enrich-stop" class="btn btn-default" style="display:none"><i class="fa fa-stop"></i> {{ button_enrich_stop }}</button>
          <span id="vm-enrich-msg" class="text-muted" style="margin-left:10px"></span>
        </p>
        <div class="well well-sm" style="max-width:1000px">
          <b>{{ text_cron_title }}</b>
          {% if cron_installed %}
          <p style="margin:6px 0">{{ text_cron_help }}</p>
          <code style="display:block;white-space:pre-wrap;word-break:break-all;padding:8px">*/2 * * * * wget -q -O /dev/null "{{ cron_url }}"</code>
          <p class="text-muted" style="margin:6px 0 0"><small>{{ text_cron_test }} <a href="{{ cron_url }}&amp;seconds=15" target="_blank" rel="noopener">{{ text_cron_open }}</a></small></p>
          {% else %}
          <p class="text-danger" style="margin:6px 0 0">{{ text_cron_missing }}</p>
          {% endif %}
        </div>
        {% if enrich_sample %}
        <details><summary style="cursor:pointer">{{ text_en_sample }} — {{ enrich_sample.name }}</summary>
          <p><small>{{ enrich_sample.node }}</small></p>
          <pre style="max-height:260px;overflow:auto;font-size:11px">{{ enrich_sample.cars_json }}</pre>
        </details>
        {% endif %}
      </div>
    </div>

    <!-- UTR API -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_utr_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_utr_help }}</p>
        <form action="{{ utr_save }}" method="post" class="form-horizontal" autocomplete="off">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_utr_email }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_utr_email" value="{{ module_vm_catalog_utr_email }}" class="form-control" autocomplete="off"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_utr_password }}</label><div class="col-sm-4"><input type="password" name="module_vm_catalog_utr_password" value="" placeholder="{% if utr_password_set %}{{ text_utr_password_set }}{% endif %}" class="form-control" autocomplete="new-password"></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-default"><i class="fa fa-save"></i> {{ button_save }}</button>
            <button type="button" id="vm-utr-probe" class="btn btn-info"><i class="fa fa-stethoscope"></i> {{ button_utr_probe }}</button>
            <button type="button" id="vm-utr-price" class="btn btn-primary"><i class="fa fa-cloud-download"></i> {{ button_utr_price }}</button>
          </div></div>
        </form>
        <div id="vm-utr-result" style="max-width:900px"></div>
      </div>
    </div>

    <!-- markups -->
    <div class="panel panel-default" id="vm-mk">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-percent"></i> {{ text_mk_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_mk_help }}</p>
        <div class="row">
          <div class="col-md-5">
            <h4>{{ text_mk_suppliers }}</h4>
            <table class="table table-bordered table-condensed" id="vm-mk-sup">
              <thead><tr><th>{{ column_supplier }}</th><th class="text-right">{{ column_total }}</th><th style="width:130px">{{ text_mk_percent }}</th></tr></thead>
              <tbody>
              {% for s in markup_suppliers %}<tr data-supplier="{{ s.supplier }}"><td><b>{{ s.supplier }}</b></td><td class="text-right">{{ s.total }}</td><td><div class="input-group input-group-sm"><input type="text" class="form-control vm-mk-sv" value="{{ s.markup }}" placeholder="{{ module_vm_catalog_markup }}"><span class="input-group-addon">%</span></div></td></tr>
              {% else %}<tr><td colspan="3" class="text-muted">{{ text_mk_no_sup }}</td></tr>{% endfor %}
              </tbody>
            </table>
            <p class="help-block">{{ text_mk_default|format(module_vm_catalog_markup) }}</p>
          </div>
          <div class="col-md-7">
            <h4>{{ text_mk_brands }}</h4>
            <table class="table table-bordered table-condensed" id="vm-mk-br">
              <thead><tr><th style="width:130px">{{ column_supplier }}</th><th>{{ text_mk_brand }}</th><th style="width:130px">{{ text_mk_percent }}</th><th style="width:40px"></th></tr></thead>
              <tbody></tbody>
            </table>
            <button type="button" class="btn btn-default btn-sm" id="vm-mk-add"><i class="fa fa-plus"></i> {{ text_mk_add }}</button>
            <datalist id="vm-mk-dl"></datalist>
          </div>
        </div>
        <hr>
        <button type="button" class="btn btn-primary" id="vm-mk-save"><i class="fa fa-save"></i> {{ text_mk_save }}</button>
        <button type="button" class="btn btn-success" id="vm-mk-recalc"><i class="fa fa-refresh"></i> {{ text_mk_save_recalc }}</button>
        <div id="vm-mk-status" style="margin-top:12px;max-width:720px"></div>
        <div class="progress" id="vm-mk-bar" style="display:none;max-width:720px"><div class="progress-bar progress-bar-striped active" style="width:0%"></div></div>
      </div>
    </div>

    <!-- BM Parts as a supplier -->
    <div class="panel panel-default" id="vm-bms">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-truck"></i> {{ text_bms_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_bms_help }}</p>
        <div class="row">
          <div class="col-md-7">
            <div class="input-group input-group-sm" style="margin-bottom:8px">
              <input type="text" id="vm-bms-find" class="form-control" placeholder="{{ text_bms_find }}">
              <span class="input-group-btn"><button type="button" id="vm-bms-load" class="btn btn-default"><i class="fa fa-refresh"></i> {{ text_bms_load }}</button></span>
            </div>
            <div id="vm-bms-tree" style="max-height:420px;overflow:auto;border:1px solid #e3e6ea;border-radius:4px;padding:8px;background:#fcfcfd"><span class="text-muted">{{ text_bms_tree_hint }}</span></div>
            <p class="help-block" id="vm-bms-sel"></p>
          </div>
          <div class="col-md-5">
            <div class="form-group"><label>{{ text_bms_local }}</label><select id="vm-bms-local" class="form-control"><option value="">{{ text_bms_local_none }}</option>{% if bms_local %}<option value="{{ bms_local }}" selected>{{ bms_local }}</option>{% endif %}</select><p class="help-block">{{ text_bms_local_help }}</p></div>
            <div class="form-group"><label>{{ text_bms_days }}</label><input type="number" min="1" max="60" id="vm-bms-days" class="form-control" value="{{ bms_days }}" style="max-width:120px"></div>
            <div class="checkbox"><label><input type="checkbox" id="vm-bms-only"{% if bms_only %} checked{% endif %}> {{ text_bms_only }}</label></div>
            <p class="help-block">{{ text_bms_markup }}</p>
          </div>
        </div>
        <button type="button" class="btn btn-primary" id="vm-bms-save"><i class="fa fa-save"></i> {{ text_bms_save }}</button>
        <button type="button" class="btn btn-success" id="vm-bms-run"><i class="fa fa-cloud-download"></i> {{ text_bms_run }}</button>
        <div id="vm-bms-status" style="margin-top:12px;max-width:820px"></div>
        <div class="progress" id="vm-bms-bar" style="display:none;max-width:820px"><div class="progress-bar progress-bar-striped active" style="width:0%"></div></div>
        <details id="vm-bms-sample" style="display:none;max-width:820px"><summary>{{ text_bms_sample }}</summary><pre style="max-height:300px;overflow:auto;font-size:11px"></pre></details>
      </div>
    </div>

    <!-- UTR YML: photos & characteristics -->
    <div class="panel panel-default" id="vm-yml">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-picture-o"></i> {{ text_yml_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_yml_help }}</p>
        <div class="form-inline" style="margin-bottom:10px">
          <input type="file" id="vm-yml-file" accept=".xml,.yml" class="form-control">
          <label style="margin-left:10px">{{ text_yml_max }}
            <select id="vm-yml-max" class="form-control">{% for n in 1..6 %}<option value="{{ n }}"{% if n == yml_photos_max %} selected{% endif %}>{{ n }}</option>{% endfor %}</select>
          </label>
          <button type="button" id="vm-yml-go" class="btn btn-primary" style="margin-left:10px"><i class="fa fa-upload"></i> {{ text_yml_go }}</button>
          {% if yml_job and not yml_job.finished %}<button type="button" id="vm-yml-resume" class="btn btn-default"><i class="fa fa-play"></i> {{ button_resume }}</button>{% endif %}
        </div>
        <div id="vm-yml-status" style="max-width:820px">{% if yml_job and yml_job.finished %}<div class="alert alert-success">{{ text_yml_last|format(yml_job.date, yml_job.stats.matched, yml_job.stats.photos, yml_job.stats.props, yml_job.stats.desc) }}</div>{% endif %}</div>
        <div class="progress" id="vm-yml-bar" style="display:none;max-width:820px"><div class="progress-bar progress-bar-striped active" style="width:0%"></div></div>
        <h4 style="margin-top:18px">{{ text_yml_photos }}</h4>
        <p id="vm-yml-pstats">{{ text_yml_pstats|format(yml_photo.done, yml_photo.products, yml_photo.pending, yml_photo.failed) }}</p>
        {% if yml_photo.error %}<p class="text-danger small">{{ yml_photo.error }}</p>{% endif %}
        <button type="button" id="vm-yml-photos" class="btn btn-success"{% if not yml_photo.pending %} disabled{% endif %}><i class="fa fa-download"></i> {{ text_yml_photos_go }}</button>
        <button type="button" id="vm-yml-stop" class="btn btn-default" style="display:none"><i class="fa fa-stop"></i> {{ text_yml_stop }}</button>
        <p class="help-block">{{ text_yml_cron }}</p>
      </div>
    </div>

    <!-- import -->
    <div class="panel panel-primary">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-upload"></i> {{ text_imp_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_imp_help }}</p>
        <form id="vm-imp-form" class="form-horizontal" enctype="multipart/form-data" onsubmit="return false">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_supplier }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_supplier" value="{{ module_vm_catalog_supplier }}" class="form-control"><p class="help-block">{{ help_supplier }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_local }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_local" value="{{ module_vm_catalog_local }}" class="form-control"><p class="help-block">{{ help_local }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_site_local }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_site_local" value="{{ module_vm_catalog_site_local }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_site_remote }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_site_remote" value="{{ module_vm_catalog_site_remote }}" class="form-control"><p class="help-block">{{ help_site_names }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_days }}</label><div class="col-sm-2"><input type="number" min="1" max="60" name="module_vm_catalog_days" value="{{ module_vm_catalog_days }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_markup }}</label><div class="col-sm-2"><input type="text" name="module_vm_catalog_markup" value="{{ module_vm_catalog_markup }}" class="form-control"></div><div class="col-sm-5"><p class="help-block">{{ help_markup }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_round }}</label><div class="col-sm-3"><select name="module_vm_catalog_round" class="form-control"><option value="0"{% if module_vm_catalog_round == 0 %} selected{% endif %}>{{ text_round_0 }}</option><option value="2"{% if module_vm_catalog_round == 2 %} selected{% endif %}>{{ text_round_2 }}</option></select></div></div>
          <input type="hidden" name="module_vm_catalog_update_url" value="{{ module_vm_catalog_update_url }}">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_file }}</label><div class="col-sm-5"><input type="file" name="file" accept=".xlsx,.csv" class="form-control"><p class="help-block">max {{ upload_max }}</p></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="button" id="vm-imp-go" class="btn btn-primary"><i class="fa fa-upload"></i> {{ button_import }}</button>
            <button type="button" id="vm-imp-resume" class="btn btn-default"{% if not job or job.finished %} style="display:none"{% endif %}><i class="fa fa-play"></i> {{ button_resume }}</button>
          </div></div>
        </form>
        <div id="vm-imp-status" style="max-width:720px">
          {% if job and not job.finished %}<div class="alert alert-info">{{ text_imp_resume|format(job.done, job.total) }}</div>{% endif %}
        </div>
        <div class="progress" id="vm-imp-bar" style="display:none;max-width:720px"><div class="progress-bar progress-bar-striped active" style="width:0%"></div></div>

        {% if stats %}
        <h4 style="margin-top:20px">{{ text_stats }}</h4>
        <table class="table table-condensed table-bordered" style="max-width:720px">
          <tr><th>{{ column_supplier }}</th><th>{{ column_total }}</th><th>{{ column_local }}</th><th>{{ column_remote }}</th><th>{{ column_last }}</th></tr>
          {% for s in stats %}<tr><td>{{ s.supplier }}</td><td>{{ s.total }}</td><td>{{ s.local_cnt }}</td><td>{{ s.remote_cnt }}</td><td>{{ s.last }}</td></tr>{% endfor %}
        </table>
        {% endif %}
      </div>
    </div>

    <!-- categories -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-sitemap"></i> {{ text_cat_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_cat_help|format(cat_preset|length, cat_total) }}</p>
        <details style="margin-bottom:12px"><summary style="cursor:pointer">{{ text_cat_preview }}</summary>
          <div style="columns:3;column-gap:24px;margin-top:10px;font-size:12px">
          {% for root in cat_preset %}<div style="break-inside:avoid;margin-bottom:10px"><b>{{ root.name }}</b> <span class="text-muted">({{ root.children|length }})</span><br>{{ root.children|join(', ') }}</div>{% endfor %}
          </div>
        </details>
        <button type="button" id="vm-cat-go" class="btn btn-primary"><i class="fa fa-sitemap"></i> {{ button_categorize }}</button>
        <form action="{{ categories_action }}" method="post" style="display:inline">
          <button type="submit" class="btn btn-default" onclick="return confirm('{{ text_cat_confirm|e('js') }}');"><i class="fa fa-plus"></i> {{ button_cat_create }}</button>
        </form>
        <div id="vm-cat-status" style="max-width:720px;margin-top:12px"></div>
      </div>
    </div>

    <!-- updates -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-refresh"></i> {{ text_upd_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_version|format(version) }}</p>
        {% if update_info %}
        <div class="alert alert-info">{{ text_upd_available|format(update_info.version, update_info.current) }}{% if update_info.notes %}<br><small>{{ update_info.notes }}</small>{% endif %}</div>
        <form action="{{ update_action }}" method="post" style="display:inline"><button type="submit" class="btn btn-success"><i class="fa fa-download"></i> {{ button_update|format(update_info.version) }}</button></form>
        {% else %}
        <a href="{{ check_action }}" class="btn btn-default"><i class="fa fa-search"></i> {{ button_check }}</a>
        {% endif %}
        {% if backups %}
        <p style="margin-top:15px"><b>{{ text_backups }}</b></p>
        <table class="table table-condensed" style="max-width:520px">
          {% for b in backups %}<tr><td>v{{ b.version }}</td><td class="text-muted">{{ b.date }}</td><td class="text-right"><a href="{{ rollback }}&amp;backup={{ b.file }}" class="btn btn-warning btn-xs" onclick="return confirm('{{ text_confirm_rb|e('js') }}');"><i class="fa fa-undo"></i> {{ button_rollback }}</a></td></tr>{% endfor %}
        </table>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function ($) {
  var uploadUrl = '{{ upload_url|e('js') }}', stepUrl = '{{ step_url|e('js') }}';
  var T = {
    reading: '{{ text_reading|e('js') }}', progress: '{{ text_progress|e('js') }}',
    done: '{{ text_imp_done|e('js') }}', countOff: '{{ text_count_off|e('js') }}', guard: '{{ text_guard|e('js') }}', network: '{{ text_network|e('js') }}'
  };
  function fmt(s, a) { var i = 0; return s.replace(/%s/g, function () { return a[i++]; }); }
  function status(html, cls) { $('#vm-imp-status').html('<div class="alert alert-' + (cls || 'info') + '">' + html + '</div>'); }
  function bar(p) { $('#vm-imp-bar').show().find('.progress-bar').css('width', p + '%').text(p + '%'); }
  function lock(on) { $('#vm-imp-go, #vm-imp-resume').prop('disabled', on); }

  function step() {
    $.ajax({ url: stepUrl, type: 'post', dataType: 'json', timeout: 180000 }).done(function (j) {
      if (j.error) { lock(false); status(j.error, 'danger'); return; }
      bar(j.total ? Math.floor(j.done * 100 / j.total) : 100);
      if (j.finished) {
        lock(false); $('#vm-imp-resume').hide();
        $('#vm-imp-bar .progress-bar').removeClass('active');
        var s = j.stats;
        status(fmt(T.done, [s.created, s.updated, s.local, s.remote, s.skipped, s.hidden]) + (s.count_off ? '<br>' + T.countOff : '') + (s.guard ? '<br><b>' + fmt(T.guard, [s.guard]) + '</b>' : ''), s.guard ? 'warning' : 'success');
        return;
      }
      status(fmt(T.progress, [j.done, j.total]));
      step();
    }).fail(function () { lock(false); $('#vm-imp-resume').show(); status(T.network, 'warning'); });
  }

  $('#vm-imp-go').on('click', function () {
    var form = $('#vm-imp-form')[0];
    if (!form.file.files.length) { form.file.focus(); return; }
    lock(true); status(T.reading); bar(0);
    $.ajax({ url: uploadUrl, type: 'post', data: new FormData(form), processData: false, contentType: false, dataType: 'json', timeout: 600000 })
      .done(function (j) {
        if (j.error) { lock(false); status(j.error, 'danger'); return; }
        if (j.warning) { $('#vm-imp-status').after('<div class="alert alert-warning" style="max-width:720px">' + j.warning + '</div>'); }
        status(fmt(T.progress, [0, j.total])); step();
      })
      .fail(function () { lock(false); status(T.network, 'warning'); });
  });

  $('#vm-imp-resume').on('click', function () { lock(true); step(); });


  // ---- BM Parts
  $('#vm-bm-probe').on('click', function () {
    var b = $(this).prop('disabled', true), box = $('#vm-bm-result');
    box.html('<div class="alert alert-info">{{ text_bm_probing|e('js') }}</div>');
    $.getJSON('{{ bm_probe_url|e('js') }}', { q: $('#vm-bm-q').val() }).done(function (j) {
      if (j.error) { box.html('<div class="alert alert-danger">' + esc(j.error) + '</div>'); return; }
      var h = '<table class="table table-condensed table-bordered" style="font-size:12px"><tr><th style="width:28%">Що перевіряли</th><th>Код</th><th>Що повернуло</th></tr>';
      $.each(j.steps, function (i, r) {
        h += '<tr><td>' + esc(r.name) + '</td><td>' + esc(r.code) + '</td><td style="word-break:break-word">' + (r.error ? '<span class="text-danger">' + esc(r.error) + '</span> ' : '') + '<code style="white-space:pre-wrap">' + esc(r.shape) + '</code></td></tr>';
      });
      box.html(h + '</table>');
    }).fail(function (x) { box.html('<div class="alert alert-warning">{{ text_probe_fail|e('js') }}<br><small>' + esc((x.responseText || '').slice(0, 300)) + '</small></div>'); }).always(function () { b.prop('disabled', false); });
  });



  // ---- categorize
  $('#vm-cat-go').on('click', function () {
    if (!confirm('{{ text_categorize_confirm|e('js') }}')) { return; }
    var b = $(this).prop('disabled', true), box = $('#vm-cat-status'), moved = 0;
    (function go(after) {
      $.ajax({ url: '{{ categorize_url|e('js') }}', data: { after: after }, dataType: 'json', timeout: 180000 }).done(function (j) {
        if (j.error) { b.prop('disabled', false); box.html('<div class="alert alert-danger">' + esc(j.error) + '</div>'); return; }
        moved += j.moved;
        var pct = j.total ? Math.floor(j.done * 100 / j.total) : 100;
        box.html('<div class="progress"><div class="progress-bar progress-bar-striped active" style="width:' + pct + '%">' + pct + '%</div></div><p>' + fmt('{{ text_categorize_progress|e('js') }}', [j.done, j.total, moved]) + '</p>');
        if (j.finished) { b.prop('disabled', false); box.html('<div class="alert alert-success">' + fmt('{{ text_categorize_done|e('js') }}', [moved, j.other_left]) + '</div>'); return; }
        go(j.after);
      }).fail(function () { setTimeout(function () { go(after); }, 4000); });
    })(0);
  });

  // ---- BM enrichment loop
  var enrichOn = false;
  function enrichStats(st) {
    var t = $('#vm-enrich-stats');
    t.find('[data-k=checked_total]').text(st.checked + ' / ' + st.total);
    t.find('[data-k=found]').text(st.found); t.find('[data-k=notfound]').text(st.notfound); t.find('[data-k=errors]').text(st.errors);
    t.find('[data-k=cars]').html(st.with_cars + ' <small class="text-muted">(' + st.models + ' {{ text_en_models|e('js') }})</small>');
    t.find('[data-k=with_analogs]').text(st.with_analogs); t.find('[data-k=images]').text(st.images);
    $('#vm-img-error').toggle(!!st.img_error).find('span').text(st.img_error || '');
  }
  function enrichStep() {
    if (!enrichOn) { return; }
    $('#vm-enrich-msg').text('{{ text_en_working|e('js') }}');
    $.ajax({ url: '{{ enrich_url|e('js') }}', dataType: 'json', timeout: 120000 }).done(function (j) {
      if (j.error) { enrichStop(esc(j.error)); return; }
      enrichStats(j.stats);
      var r = j.run;
      $('#vm-enrich-msg').text('+' + r.found + ' / ' + r.checked + ' (' + r.requests + ' req)');
      if (r.stopped === 'done') { enrichStop('{{ text_en_done|e('js') }}'); return; }
      if (r.stopped) { enrichStop(esc(r.stopped)); return; }
      setTimeout(enrichStep, 500);
    }).fail(function () { setTimeout(enrichStep, 5000); });
  }
  function enrichStop(msg) { enrichOn = false; $('#vm-enrich-go').show(); $('#vm-enrich-stop').hide(); $('#vm-enrich-msg').html(msg || ''); }
  $('#vm-enrich-go').on('click', function () { enrichOn = true; $(this).hide(); $('#vm-enrich-stop').show(); enrichStep(); });
  $('#vm-enrich-stop').on('click', function () { enrichStop('{{ text_en_stopped|e('js') }}'); });

  // ---- UTR
  var utrProbeUrl = '{{ utr_probe_url|e('js') }}', utrPriceUrl = '{{ utr_price_url|e('js') }}';
  function utrMsg(html, cls) { $('#vm-utr-result').html('<div class="alert alert-' + (cls || 'info') + '">' + html + '</div>'); }
  function esc(t) { return $('<div>').text(t == null ? '' : String(t)).html(); }

  $('#vm-utr-probe').on('click', function () {
    var b = $(this).prop('disabled', true);
    utrMsg('{{ text_utr_probing|e('js') }}');
    $.getJSON(utrProbeUrl).done(function (j) {
      if (j.error) { utrMsg(esc(j.error), 'danger'); return; }
      var h = '<p><b>{{ text_utr_login_ok|e('js') }}</b></p><table class="table table-condensed table-bordered"><tr><th>Артикул</th><th>Бренд</th><th>Пошук</th><th>Назва / категорія UTR</th><th>Складів</th><th>Застосовність</th><th>Аналоги</th><th>Інші поля</th></tr>';
      $.each(j.items, function (i, r) {
        h += '<tr><td>' + esc(r.article) + '</td><td>' + esc(r.brand) + '</td><td>' + esc(r.search) + '</td><td>' + esc(r.title) + '<br><small>' + esc(r.category) + '</small></td><td>' + esc(r.storages) + '</td><td>' + esc(r.applicability) + '</td><td>' + esc(r.analogs) + '</td><td><small>' + esc(r.extra) + '</small></td></tr>';
      });
      utrMsg(h + '</table><p class="text-muted">{{ text_utr_codes|e('js') }}</p>', 'info');
    }).fail(function (x) { utrMsg('{{ text_probe_fail|e('js') }}<br><small>' + esc((x.responseText || '').slice(0, 300)) + '</small>', 'warning'); }).always(function () { b.prop('disabled', false); });
  });

  $('#vm-utr-price').on('click', function () {
    var b = $(this).prop('disabled', true);
    utrMsg('{{ text_utr_requesting|e('js') }}');
    $.getJSON(utrPriceUrl + '&step=request').done(function (j) {
      if (j.error) { b.prop('disabled', false); utrMsg(esc(j.error), 'danger'); return; }
      var id = j.id, tries = 0;
      (function poll() {
        $.getJSON(utrPriceUrl + '&step=import&id=' + id, { _: Date.now() }).done(function (s) {
          if (s.error) { b.prop('disabled', false); utrMsg(esc(s.error), 'danger'); return; }
          if (s.status === 'started') {
            b.prop('disabled', false);
            utrMsg('{{ text_utr_downloaded|e('js') }}', 'success');
            $('html,body').animate({ scrollTop: $('#vm-imp-status').offset().top - 80 }, 300);
            lock(true); bar(0); status(fmt(T.progress, [0, s.total])); step();
            return;
          }
          if (s.status === 'error') { b.prop('disabled', false); utrMsg('{{ text_utr_price_error|e('js') }}', 'danger'); return; }
          utrMsg('{{ text_utr_waiting|e('js') }} (' + (++tries * 10) + ' с)');
          setTimeout(poll, 10000);
        }).fail(function () { setTimeout(poll, 15000); });
      })();
    }).fail(function () { b.prop('disabled', false); utrMsg(T.network, 'warning'); });
  });


  // ---------- markups
  (function () {
    var sups = {{ markup_suppliers|json_encode|raw }}, rules = {{ markup_brands|json_encode|raw }};
    var tb = $('#vm-mk-br tbody'), dlTimer;
    function supSelect(v) {
      var h = '<select class="form-control input-sm vm-mk-bs">';
      sups.forEach(function (s) { h += '<option value="' + s.supplier + '"' + (s.supplier === v ? ' selected' : '') + '>' + s.supplier + '</option>'; });
      return h + '</select>';
    }
    function row(r) {
      var tr = $('<tr><td>' + supSelect(r.supplier) + '</td><td><input type="text" class="form-control input-sm vm-mk-bb" list="vm-mk-dl" autocomplete="off"></td><td><div class="input-group input-group-sm"><input type="text" class="form-control vm-mk-bv"><span class="input-group-addon">%</span></div></td><td><button type="button" class="btn btn-danger btn-xs vm-mk-del"><i class="fa fa-times"></i></button></td></tr>');
      tr.find('.vm-mk-bb').val(r.brand || ''); tr.find('.vm-mk-bv').val(r.markup || '');
      tb.append(tr);
    }
    rules.forEach(row);
    $('#vm-mk-add').on('click', function () { if (!sups.length) return; row({ supplier: sups[0].supplier, brand: '', markup: '' }); tb.find('.vm-mk-bb').last().focus(); });
    tb.on('click', '.vm-mk-del', function () { $(this).closest('tr').remove(); });
    tb.on('input focus', '.vm-mk-bb', function () {
      var inp = $(this), sup = inp.closest('tr').find('.vm-mk-bs').val();
      clearTimeout(dlTimer);
      dlTimer = setTimeout(function () {
        $.getJSON('{{ markup_brands_url|e('js') }}', { supplier: sup, q: inp.val() }, function (j) {
          var h = ''; (j.brands || []).forEach(function (b) { h += '<option value="' + $('<div>').text(b.brand).html() + '">' + b.total + '</option>'; });
          $('#vm-mk-dl').html(h);
        });
      }, 250);
    });
    function collect() {
      var out = [];
      $('#vm-mk-sup tbody tr[data-supplier]').each(function () { var v = $.trim($(this).find('.vm-mk-sv').val()); if (v !== '') out.push({ supplier: $(this).data('supplier'), brand: '', markup: v }); });
      tb.find('tr').each(function () { var b = $.trim($(this).find('.vm-mk-bb').val()), v = $.trim($(this).find('.vm-mk-bv').val()); if (b !== '' && v !== '') out.push({ supplier: $(this).find('.vm-mk-bs').val(), brand: b, markup: v }); });
      return out;
    }
    function save(cb) {
      $('#vm-mk-status').html('<div class="alert alert-info">{{ text_mk_saving|e('js') }}</div>');
      $.post('{{ markup_save_url|e('js') }}', { rules: JSON.stringify(collect()) }, null, 'json').done(function (j) {
        if (j.error) { $('#vm-mk-status').html('<div class="alert alert-danger">' + j.error + '</div>'); return; }
        $('#vm-mk-status').html('<div class="alert alert-success">{{ text_mk_saved|e('js') }}'.replace('%s', j.saved) + '</div>');
        if (cb) cb();
      }).fail(function (x) { $('#vm-mk-status').html('<div class="alert alert-danger">' + $('<div>').text(x.responseText.substr(0, 300)).html() + '</div>'); });
    }
    $('#vm-mk-save').on('click', function () { save(); });
    $('#vm-mk-recalc').on('click', function () {
      var btn = $(this).prop('disabled', true), changed = 0, bar = $('#vm-mk-bar').show().find('.progress-bar');
      save(function () {
        (function go(after) {
          $.ajax({ url: '{{ markup_recalc_url|e('js') }}', data: { after: after }, dataType: 'json', timeout: 180000 }).done(function (j) {
            if (j.error) { $('#vm-mk-status').html('<div class="alert alert-danger">' + j.error + '</div>'); btn.prop('disabled', false); return; }
            changed += j.changed || 0;
            if (j.total) bar.css('width', Math.round(100 * (j.done ? j.total : j.pos) / j.total) + '%');
            if (j.done) { bar.css('width', '100%'); $('#vm-mk-status').html('<div class="alert alert-success">{{ text_mk_recalc_done|e('js') }}'.replace('%s', changed) + '</div>'); btn.prop('disabled', false); setTimeout(function () { $('#vm-mk-bar').hide(); }, 1500); return; }
            $('#vm-mk-status').html('<div class="alert alert-info">{{ text_mk_recalc_run|e('js') }}'.replace('%s', j.pos).replace('%s', j.total) + '</div>');
            go(j.after);
          }).fail(function () { setTimeout(function () { go(after); }, 4000); });
        })(0);
      });
    });
  })();

  // ---------- UTR YML
  (function () {
    var st = $('#vm-yml-status'), bar = $('#vm-yml-bar'), pb = bar.find('.progress-bar'), CH = 4 * 1024 * 1024;
    function msg(cls, t) { st.html('<div class="alert alert-' + cls + '">' + t + '</div>'); }
    function fail(x) { msg('danger', x && x.responseText ? $('<div>').text(x.responseText.substr(0, 400)).html() : '{{ text_yml_neterr|e('js') }}'); $('#vm-yml-go').prop('disabled', false); }
    function steps() {
      $.ajax({ url: '{{ yml_step_url|e('js') }}', dataType: 'json', timeout: 180000 }).done(function (j) {
        if (j.error) { msg('danger', j.error); $('#vm-yml-go').prop('disabled', false); return; }
        var pct = j.total ? Math.round(100 * j.done / j.total) : 0;
        pb.css('width', pct + '%');
        var s = j.stats;
        if (j.finished) {
          msg('success', '{{ text_yml_done|e('js') }}'.replace('%s', s.matched).replace('%s', s.unmatched).replace('%s', s.photos).replace('%s', s.props).replace('%s', s.desc));
          $('#vm-yml-go').prop('disabled', false); setTimeout(function () { bar.hide(); }, 1500);
          $('#vm-yml-photos').prop('disabled', false);
          return;
        }
        msg('info', '{{ text_yml_run|e('js') }}'.replace('%s', j.done).replace('%s', j.total).replace('%s', s.matched).replace('%s', s.photos));
        steps();
      }).fail(function () { setTimeout(steps, 4000); });
    }
    $('#vm-yml-resume').on('click', function () { bar.show(); steps(); });
    $('#vm-yml-go').on('click', function () {
      var f = $('#vm-yml-file')[0].files[0];
      if (!f) { msg('warning', '{{ text_yml_pick|e('js') }}'); return; }
      $(this).prop('disabled', true); bar.show(); pb.css('width', '0%');
      var parts = Math.ceil(f.size / CH);
      (function send(i) {
        if (i >= parts) {
          msg('info', '{{ text_yml_parsing|e('js') }}');
          $.post('{{ yml_start_url|e('js') }}', { photos: $('#vm-yml-max').val() }, null, 'json').done(function (j) {
            if (j.error) { msg('danger', j.error); $('#vm-yml-go').prop('disabled', false); return; }
            pb.css('width', '0%'); steps();
          }).fail(fail);
          return;
        }
        var fd = new FormData(); fd.append('index', i); fd.append('chunk', f.slice(i * CH, Math.min(f.size, (i + 1) * CH)), 'part');
        $.ajax({ url: '{{ yml_chunk_url|e('js') }}', type: 'POST', data: fd, processData: false, contentType: false, dataType: 'json', timeout: 180000 }).done(function (j) {
          if (j.error) { msg('danger', j.error); $('#vm-yml-go').prop('disabled', false); return; }
          pb.css('width', Math.round(100 * (i + 1) / parts) + '%');
          msg('info', '{{ text_yml_upload|e('js') }}'.replace('%s', Math.round((i + 1) * CH / 1048576 > f.size / 1048576 ? f.size / 1048576 : (i + 1) * CH / 1048576)).replace('%s', Math.round(f.size / 1048576)));
          send(i + 1);
        }).fail(function (x) { if (i > 0 && x.status === 0) { setTimeout(function () { send(i); }, 3000); } else { fail(x); } });
      })(0);
    });
    var stop = false;
    $('#vm-yml-stop').on('click', function () { stop = true; });
    $('#vm-yml-photos').on('click', function () {
      var btn = $(this).prop('disabled', true); stop = false; $('#vm-yml-stop').show();
      (function go() {
        $.ajax({ url: '{{ yml_photos_url|e('js') }}', dataType: 'json', timeout: 180000 }).done(function (j) {
          if (j.error) { $('#vm-yml-pstats').text(j.error); btn.prop('disabled', false); $('#vm-yml-stop').hide(); return; }
          var s = j.stats;
          $('#vm-yml-pstats').text('{{ text_yml_pstats|e('js') }}'.replace('%s', s.done).replace('%s', s.products).replace('%s', s.pending).replace('%s', s.failed));
          if (stop || !s.pending || (j.run && j.run.done === 0 && j.run.failed > 0 && s.error)) { btn.prop('disabled', !s.pending); $('#vm-yml-stop').hide(); if (s.error) $('#vm-yml-pstats').append(' — ' + s.error); return; }
          go();
        }).fail(function () { setTimeout(go, 4000); });
      })();
    });
  })();

  // ---------- BM Parts as a supplier
  (function () {
    var saved = {{ bms_groups|json_encode|raw }}, curLocal = {{ bms_local|json_encode|raw }}, tree = $('#vm-bms-tree');
    function esc(t) { return $('<div>').text(t).html(); }
    function node(g) {
      var kids = g.children && g.children.length, h = '<li data-path="' + esc(g.path) + '" data-name="' + esc(g.name.toLowerCase()) + '">';
      h += (kids ? '<a href="#" class="vm-bms-tg" style="display:inline-block;width:16px;color:#888"><i class="fa fa-caret-right"></i></a>' : '<span style="display:inline-block;width:16px"></span>');
      h += '<label style="font-weight:normal;margin:0"><input type="checkbox" value="' + esc(g.path) + '"' + (saved.indexOf(g.path) > -1 ? ' checked' : '') + '> ' + esc(g.name) + ' <span class="text-muted">(' + g.n + ')</span></label>';
      if (kids) { h += '<ul style="list-style:none;padding-left:20px;display:none">' + g.children.map(node).join('') + '</ul>'; }
      return h + '</li>';
    }
    function count() {
      var c = tree.find('input:checked').filter(function () { return !$(this).closest('ul').closest('li').find('> label input').is(':checked'); });
      var n = 0; c.each(function () { var m = $(this).parent().find('.text-muted').text().match(/\d+/); n += m ? +m[0] : 0; });
      $('#vm-bms-sel').text('{{ text_bms_selected|e('js') }}'.replace('%s', c.length).replace('%s', n));
    }
    function load(refresh) {
      tree.html('<span class="text-muted">{{ text_bms_loading|e('js') }}</span>');
      $.getJSON('{{ bms_groups_url|e('js') }}', { refresh: refresh ? 1 : 0 }, function (j) {
        if (j.tree && j.tree.error) { tree.html('<span class="text-danger">' + esc(j.tree.error) + '</span>'); return; }
        tree.html('<ul style="list-style:none;padding-left:0;margin:0">' + j.tree.groups.map(node).join('') + '</ul>');
        tree.find('input:checked').each(function () { $(this).parents('ul').show(); $(this).parents('li').find('> .vm-bms-tg i').attr('class', 'fa fa-caret-down'); });
        var sel = $('#vm-bms-local').empty().append('<option value="">{{ text_bms_local_none|e('js') }}</option>');
        (j.warehouses || []).forEach(function (w) { sel.append($('<option>').val(w.name).text(w.name).prop('selected', w.name === curLocal)); });
        if (curLocal && !sel.find('option:selected').length) sel.append($('<option>').val(curLocal).text(curLocal).prop('selected', true));
        count();
      });
    }
    tree.on('click', '.vm-bms-tg', function (e) { e.preventDefault(); var ul = $(this).siblings('ul').toggle(); $(this).find('i').attr('class', ul.is(':visible') ? 'fa fa-caret-down' : 'fa fa-caret-right'); });
    tree.on('change', 'input', function () { $(this).closest('li').find('ul input').prop('checked', false).prop('disabled', this.checked); count(); });
    $('#vm-bms-find').on('input', function () {
      var v = $.trim(this.value.toLowerCase());
      tree.find('li').each(function () { var li = $(this), hit = !v || li.attr('data-name').indexOf(v) > -1 || li.find('li[data-name*="' + v.replace(/"/g, '') + '"]').length; li.toggle(!!hit); if (v && hit) li.parents('ul').show(); });
    });
    $('#vm-bms-load').on('click', function () { load(true); });
    load(false);
    function picked() { return tree.find('input:checked:not(:disabled)').map(function () { return this.value; }).get(); }
    function msg(cls, t) { $('#vm-bms-status').html('<div class="alert alert-' + cls + '">' + t + '</div>'); }
    function save(cb) {
      $.post('{{ bms_save_url|e('js') }}', { groups: JSON.stringify(picked()), local: $('#vm-bms-local').val(), days: $('#vm-bms-days').val(), only: $('#vm-bms-only').is(':checked') ? 1 : 0 }, null, 'json').done(function (j) {
        if (j.error) { msg('danger', j.error); return; }
        saved = picked(); curLocal = $('#vm-bms-local').val();
        msg('success', '{{ text_bms_saved|e('js') }}'.replace('%s', j.saved)); if (cb) cb();
      }).fail(function (x) { msg('danger', esc((x.responseText || '').substr(0, 300))); });
    }
    $('#vm-bms-save').on('click', function () { save(); });
    $('#vm-bms-run').on('click', function () {
      if (!picked().length) { msg('warning', '{{ text_bms_none|e('js') }}'); return; }
      var btn = $(this).prop('disabled', true), bar = $('#vm-bms-bar').show().find('.progress-bar').css('width', '3%');
      function done(t, cls) { msg(cls || 'danger', t); btn.prop('disabled', false); setTimeout(function () { $('#vm-bms-bar').hide(); }, 1500); }
      save(function () {
        $.getJSON('{{ bms_run_url|e('js') }}', { step: 'start' }).done(function (j) {
          if (j.error) return done(j.error);
          (function fetch() {
            $.ajax({ url: '{{ bms_run_url|e('js') }}', data: { step: 'fetch' }, dataType: 'json', timeout: 180000 }).done(function (s) {
              if (s.error) return done(esc(s.error));
              if (s.sample) { $('#vm-bms-sample').show().find('pre').text(s.sample); }
              bar.css('width', Math.max(3, Math.round(60 * s.gi / s.groups.length)) + '%');
              if (!s.done) { msg('info', '{{ text_bms_fetch|e('js') }}'.replace('%s', s.gi + 1 > s.groups.length ? s.groups.length : s.gi + 1).replace('%s', s.groups.length).replace('%s', s.rows).replace('%s', s.requests) + (s.wait ? ' ' + s.wait : '')); return setTimeout(fetch, s.wait ? 60000 : 50); }
              msg('info', '{{ text_bms_importing|e('js') }}'.replace('%s', s.rows));
              $.getJSON('{{ bms_run_url|e('js') }}', { step: 'import' }).done(function (st) {
                if (st.error) return done(esc(st.error));
                (function stepImp() {
                  $.ajax({ url: '{{ step_url|e('js') }}', dataType: 'json', timeout: 180000 }).done(function (k) {
                    if (k.error) return done(esc(k.error));
                    bar.css('width', (60 + Math.round(40 * k.done / Math.max(1, k.total))) + '%');
                    if (!k.finished) { msg('info', '{{ text_bms_step|e('js') }}'.replace('%s', k.done).replace('%s', k.total)); return stepImp(); }
                    bar.css('width', '100%');
                    done('{{ text_bms_done|e('js') }}'.replace('%s', k.stats.created).replace('%s', k.stats.updated).replace('%s', k.stats.local).replace('%s', k.stats.remote).replace('%s', k.stats.hidden || 0), 'success');
                  }).fail(function () { setTimeout(stepImp, 4000); });
                })();
              }).fail(function (x) { done(esc((x.responseText || '').substr(0, 300))); });
            }).fail(function () { setTimeout(fetch, 5000); });
          })();
        }).fail(function (x) { done(esc((x.responseText || '').substr(0, 300))); });
      });
    });
  })();
})(jQuery);
//--></script>
{{ footer }}
