{{ header }}
<div id="account-login" class="container vm-auth">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {{ content_top }}
  <div class="vm-auth-grid">
    <div class="vm-auth-card vm-auth-main">
      <h1>{{ vm_t.text_auth_login }}</h1>
      <p class="vm-auth-lead">{{ text_i_am_returning_customer }}</p>
      {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
      {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="vm-auth-form">
        <div class="form-group">
          <label class="control-label" for="input-email">{{ entry_email }}</label>
          <div class="vm-auth-input"><i class="fa fa-envelope-o"></i><input type="email" name="email" value="{{ email }}" placeholder="name@gmail.com" id="input-email" class="form-control" autocomplete="email" required /></div>
        </div>
        <div class="form-group">
          <div class="vm-auth-label-row"><label class="control-label" for="input-password">{{ entry_password }}</label><a href="{{ forgotten }}">{{ text_forgotten }}</a></div>
          <div class="vm-auth-input"><i class="fa fa-lock"></i><input type="password" name="password" value="{{ password }}" placeholder="••••••••" id="input-password" class="form-control" autocomplete="current-password" required />
            <button type="button" class="vm-auth-eye" aria-label="{{ vm_t.text_auth_show }}" onclick="var i=document.getElementById('input-password');i.type=i.type==='password'?'text':'password';this.firstChild.className=i.type==='password'?'fa fa-eye':'fa fa-eye-slash';"><i class="fa fa-eye"></i></button></div>
        </div>
        <button type="submit" class="vm-auth-submit">{{ button_login }}</button>
        {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}" />{% endif %}
      </form>
    </div>
    <div class="vm-auth-card vm-auth-side">
      <h2>{{ text_new_customer }}</h2>
      <p class="vm-auth-lead">{{ vm_t.text_auth_why }}</p>
      <ul class="vm-auth-benefits">
        <li><i class="fa fa-history"></i> {{ vm_t.text_auth_b1 }}</li>
        <li><i class="fa fa-truck"></i> {{ vm_t.text_auth_b2 }}</li>
        <li><i class="fa fa-heart-o"></i> {{ vm_t.text_auth_b3 }}</li>
        <li><i class="fa fa-bolt"></i> {{ vm_t.text_auth_b4 }}</li>
      </ul>
      <a href="{{ register }}" class="vm-auth-secondary">{{ vm_t.text_auth_register }}</a>
      <p class="vm-auth-note">{{ vm_t.text_auth_guest }}</p>
    </div>
  </div>
  {{ content_bottom }}
</div>
{{ footer }}
