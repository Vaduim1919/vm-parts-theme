{{ header }}
<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }} vm-content">{{ content_top }}
      <h2>{{ heading_title }}</h2>
      {% if vm_car_page %}
      {{ vm_car_page.bar }}
      <p class="vm-car-found">{{ vm_t.text_car_found|format(vm_car_page.total, vm_car_page.label) }}</p>
      {% if vm_car_page.chips %}
      <div class="vm-chips">
        <a href="{{ vm_car_page.all }}" class="vm-chip{% if not vm_car_page.cat %} is-active{% endif %}">{{ vm_t.text_car_all_cats }}</a>
        {% for c in vm_car_page.chips %}<a href="{{ c.href }}" class="vm-chip{% if c.active %} is-active{% endif %}{% if not c.top %} vm-chip-sub{% endif %}">{{ c.name }} <em>{{ c.count }}</em></a>{% endfor %}
      </div>
      {% endif %}
      {% elseif vm_garage_cat %}
      <a class="vm-garage-strip" href="{{ vm_garage_cat }}"><i class="fa fa-car"></i> {{ vm_t.text_car_only|format(vm_garage.label) }} <i class="fa fa-angle-right"></i></a>
      {% endif %}
      {% if thumb or description %}
      <div class="row"> {% if thumb %}
        <div class="col-sm-2"><img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" /></div>
        {% endif %}
        {% if description %}
        <div class="col-sm-10">{{ description }}</div>
        {% endif %}</div>
      <hr>
      {% endif %}
      {% if vm_filters %}
      <div class="vm-cat-layout">
      <aside class="vm-filters" id="vm-filters" data-path="{{ vm_filters.path }}" data-reset="{{ vm_filters.reset }}">
        <div class="vm-f-head"><b><i class="fa fa-sliders"></i> {{ vm_t.text_f_title }}</b><button type="button" class="vm-f-close" aria-label="×" onclick="vmFilters(false)">&times;</button></div>
        <div class="vm-f-scroll">
        {% if vm_filters.car %}
        <label class="vm-f-car"><input type="checkbox" data-name="car" value="1"{% if vm_filters.car.on %} checked{% endif %}><span><i class="fa fa-car"></i> {{ vm_t.text_f_car }}<small>{{ vm_filters.car.label|e }}</small></span><em>{{ vm_filters.car.n }}</em></label>
        {% endif %}
        {% if vm_filters.price.max > vm_filters.price.min %}
        <div class="vm-f-group">
          <button type="button" class="vm-f-title">{{ vm_t.text_f_price }}<i class="fa fa-angle-up"></i></button>
          <div class="vm-f-body vm-f-price" data-min="{{ vm_filters.price.min }}" data-max="{{ vm_filters.price.max }}">
            <div class="vm-f-pin"><input type="number" class="vm-f-pmin" min="{{ vm_filters.price.min }}" max="{{ vm_filters.price.max }}" placeholder="{{ vm_filters.price.min }}" value="{{ vm_filters.price.from }}"><span>–</span><input type="number" class="vm-f-pmax" min="{{ vm_filters.price.min }}" max="{{ vm_filters.price.max }}" placeholder="{{ vm_filters.price.max }}" value="{{ vm_filters.price.to }}"></div>
            <div class="vm-f-range"><div class="vm-f-track"><i></i></div><input type="range" class="vm-f-r1" min="{{ vm_filters.price.min }}" max="{{ vm_filters.price.max }}" value="{{ vm_filters.price.from ?: vm_filters.price.min }}"><input type="range" class="vm-f-r2" min="{{ vm_filters.price.min }}" max="{{ vm_filters.price.max }}" value="{{ vm_filters.price.to ?: vm_filters.price.max }}"></div>
            <button type="button" class="vm-f-apply">{{ vm_t.text_f_apply }}</button>
          </div>
        </div>
        {% endif %}
        {% for g in vm_filters.groups %}
        <div class="vm-f-group{% if loop.index > 7 %} is-closed{% endif %}">
          <button type="button" class="vm-f-title">{{ g.title|e }}<i class="fa fa-angle-up"></i></button>
          <div class="vm-f-body">
            {% if g.search %}<input type="text" class="vm-f-search" placeholder="{{ vm_t.text_f_search }}">{% endif %}
            <ul>
              {% for o in g.opts %}<li{% if loop.index > 7 and not o.on %} class="vm-f-x" hidden{% endif %}><label><input type="checkbox" data-name="{{ o.name }}" value="{{ o.value|e }}"{% if o.on %} checked{% endif %}><span>{{ o.label|e }}</span><em>{{ o.n }}</em></label></li>{% endfor %}
            </ul>
            {% if g.opts|length > 7 %}<button type="button" class="vm-f-more" data-more="{{ vm_t.text_f_more|format(g.opts|length - 7) }}" data-less="{{ vm_t.text_f_less }}">{{ vm_t.text_f_more|format(g.opts|length - 7) }} <i class="fa fa-angle-down"></i></button>{% endif %}
          </div>
        </div>
        {% endfor %}
        </div>
        <div class="vm-f-foot"><button type="button" class="vm-f-show" onclick="vmFilters(false)">{{ vm_t.text_f_show }}</button></div>
      </aside>
      <div class="vm-cat-main">
        <div class="vm-f-bar">
          <button type="button" class="vm-f-open" onclick="vmFilters(true)"><i class="fa fa-sliders"></i> {{ vm_t.text_f_title }}{% if vm_filters.count %} <b>{{ vm_filters.count }}</b>{% endif %}</button>
          {% if vm_filters.chips %}
          <div class="vm-f-chips">{% for c in vm_filters.chips %}<a href="{{ c.href }}" class="vm-f-chip">{{ c.text|e }} <i class="fa fa-times"></i></a>{% endfor %}<a href="{{ vm_filters.reset }}" class="vm-f-resetall">{{ vm_t.text_f_reset }}</a></div>
          {% endif %}
          {% if vm_filter_total is defined %}<span class="vm-f-found">{{ vm_t.text_f_found|format(vm_filter_total) }}</span>{% endif %}
        </div>
      {% endif %}
      {% if categories %}
      <div class="vm-subcats">{% for category in categories %}<a href="{{ category.href }}">{{ category.name }}</a>{% endfor %}</div>
      {% endif %}
      {% if products %}
      <div class="row">
        <div class="col-md-2 col-sm-6 hidden-xs">
          <div class="btn-group btn-group-sm">
            <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
            <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="form-group"><a href="{{ compare }}" id="compare-total" class="btn btn-link">{{ text_compare }}</a></div>
        </div>
        <div class="col-md-4 col-xs-6">
          <div class="form-group input-group input-group-sm">
            <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
            <select id="input-sort" class="form-control" onchange="location = this.value;">
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="col-md-3 col-xs-6">
          <div class="form-group input-group input-group-sm">
            <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
            <select id="input-limit" class="form-control" onchange="location = this.value;">
              {% for limits in limits %}
              {% if limits.value == limit %}
              <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
              {% else %}
              <option value="{{ limits.href }}">{{ limits.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>
      </div>
      <div class="vm-grid">
{% for product in products %}
<div class="vm-card">
  <div class="vm-stickers">{% if product.vm_hit %}<span class="vm-st vm-st-hit">{{ vm_t.text_hit }}</span>{% endif %}{% if product.vm_new %}<span class="vm-st vm-st-new">{{ vm_t.text_new }}</span>{% endif %}{% if product.vm_discount %}<span class="vm-st vm-st-sale">{{ product.vm_discount }}</span>{% endif %}</div>
  <button type="button" class="vm-fav" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
  <a class="vm-card-img" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" /></a>
  {% if product.vm_stock %}<div class="vm-stock vm-stock-{{ product.vm_stock_class }}">{{ product.vm_stock }}</div>{% endif %}
  <a class="vm-card-name" href="{{ product.href }}">{{ product.name }}</a>
  {% if product.vm_fit %}<div class="vm-fit">{{ vm_t.text_fits }}: {{ product.vm_fit }}</div>{% endif %}
  {% if product.vm_model %}<div class="vm-code">{{ vm_t.text_code }}: {{ product.vm_model }}</div>{% endif %}
  <div class="vm-card-bottom">
    {% if product.price %}<div class="vm-price">{% if product.special %}<s>{{ product.price }}</s><b class="vm-price-new">{{ product.special }}</b>{% else %}<b>{{ product.price }}</b>{% endif %}</div>{% endif %}
    <button type="button" class="vm-buy" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i> {{ vm_t.text_buy }}</button>
  </div>
</div>
{% endfor %}
</div>
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
      {% endif %}
      {% if not categories and not products %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {% if vm_filters %}</div></div>{% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }} 
