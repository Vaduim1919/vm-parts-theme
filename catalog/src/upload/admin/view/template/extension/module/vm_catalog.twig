{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for b in breadcrumbs %}<li><a href="{{ b.href }}">{{ b.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if vm_catalog_error %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ vm_catalog_error }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    {% if not stock_checkout %}
    <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_checkout_off }}
      <form action="{{ checkout_action }}" method="post" style="display:inline;margin-left:10px"><button type="submit" class="btn btn-warning btn-xs">{{ button_checkout_on }}</button></form>
    </div>
    {% endif %}

    <!-- BM Parts API -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_bm_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_bm_help }}</p>
        <form action="{{ utr_save }}" method="post" class="form-horizontal" autocomplete="off">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_bm_photos }}</label><div class="col-sm-6"><select name="module_vm_catalog_bm_photos" class="form-control">
            <option value="local"{% if module_vm_catalog_bm_photos == 'local' %} selected{% endif %}>{{ text_photos_local }}</option>
            <option value="all"{% if module_vm_catalog_bm_photos == 'all' %} selected{% endif %}>{{ text_photos_all }}</option>
            <option value="none"{% if module_vm_catalog_bm_photos == 'none' %} selected{% endif %}>{{ text_photos_none }}</option>
          </select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_bm_token }}</label><div class="col-sm-6"><input type="password" name="module_vm_catalog_bm_token" value="" placeholder="{% if bm_token_set %}{{ text_utr_password_set }}{% endif %}" class="form-control" autocomplete="new-password"></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-default"><i class="fa fa-save"></i> {{ button_save }}</button>
            <input type="text" id="vm-bm-q" class="form-control" placeholder="{{ text_bm_q }}" style="display:inline-block;width:200px;vertical-align:middle">
            <button type="button" id="vm-bm-probe" class="btn btn-info"><i class="fa fa-stethoscope"></i> {{ button_utr_probe }}</button>
          </div></div>
        </form>
        <div id="vm-bm-result" style="max-width:1000px"></div>
        <hr>
        <h4>{{ text_enrich_title }}</h4>
        <p>{{ text_enrich_help }}</p>
        <table class="table table-condensed table-bordered" id="vm-enrich-stats" style="max-width:760px">
          <tr><th>{{ text_en_checked }}</th><th>{{ text_en_found }}</th><th>{{ text_en_notfound }}</th><th>{{ text_en_errors }}</th><th>{{ text_en_cars }}</th><th>{{ text_en_analogs }}</th><th>{{ text_en_photos }}</th></tr>
          <tr><td data-k="checked_total">{{ enrich_stats.checked }} / {{ enrich_stats.total }}</td><td data-k="found">{{ enrich_stats.found }}</td><td data-k="notfound">{{ enrich_stats.notfound }}</td><td data-k="errors">{{ enrich_stats.errors }}</td><td data-k="cars">{{ enrich_stats.with_cars }} <small class="text-muted">({{ enrich_stats.models }} {{ text_en_models }})</small></td><td data-k="with_analogs">{{ enrich_stats.with_analogs }}</td><td data-k="images">{{ enrich_stats.images }}</td></tr>
        </table>
        <p>
          <button type="button" id="vm-enrich-go" class="btn btn-success"><i class="fa fa-play"></i> {{ button_enrich_go }}</button>
          <button type="button" id="vm-enrich-stop" class="btn btn-default" style="display:none"><i class="fa fa-stop"></i> {{ button_enrich_stop }}</button>
          <span id="vm-enrich-msg" class="text-muted" style="margin-left:10px"></span>
        </p>
        <div class="well well-sm" style="max-width:1000px">
          <b>{{ text_cron_title }}</b>
          {% if cron_installed %}
          <p style="margin:6px 0">{{ text_cron_help }}</p>
          <code style="display:block;white-space:pre-wrap;word-break:break-all;padding:8px">*/2 * * * * wget -q -O /dev/null "{{ cron_url }}"</code>
          <p class="text-muted" style="margin:6px 0 0"><small>{{ text_cron_test }} <a href="{{ cron_url }}&amp;seconds=15" target="_blank" rel="noopener">{{ text_cron_open }}</a></small></p>
          {% else %}
          <p class="text-danger" style="margin:6px 0 0">{{ text_cron_missing }}</p>
          {% endif %}
        </div>
        {% if enrich_sample %}
        <details><summary style="cursor:pointer">{{ text_en_sample }} — {{ enrich_sample.name }}</summary>
          <p><small>{{ enrich_sample.node }}</small></p>
          <pre style="max-height:260px;overflow:auto;font-size:11px">{{ enrich_sample.cars_json }}</pre>
        </details>
        {% endif %}
      </div>
    </div>

    <!-- UTR API -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_utr_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_utr_help }}</p>
        <form action="{{ utr_save }}" method="post" class="form-horizontal" autocomplete="off">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_utr_email }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_utr_email" value="{{ module_vm_catalog_utr_email }}" class="form-control" autocomplete="off"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_utr_password }}</label><div class="col-sm-4"><input type="password" name="module_vm_catalog_utr_password" value="" placeholder="{% if utr_password_set %}{{ text_utr_password_set }}{% endif %}" class="form-control" autocomplete="new-password"></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-default"><i class="fa fa-save"></i> {{ button_save }}</button>
            <button type="button" id="vm-utr-probe" class="btn btn-info"><i class="fa fa-stethoscope"></i> {{ button_utr_probe }}</button>
            <button type="button" id="vm-utr-price" class="btn btn-primary"><i class="fa fa-cloud-download"></i> {{ button_utr_price }}</button>
          </div></div>
        </form>
        <div id="vm-utr-result" style="max-width:900px"></div>
      </div>
    </div>

    <!-- import -->
    <div class="panel panel-primary">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-upload"></i> {{ text_imp_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_imp_help }}</p>
        <form id="vm-imp-form" class="form-horizontal" enctype="multipart/form-data" onsubmit="return false">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_supplier }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_supplier" value="{{ module_vm_catalog_supplier }}" class="form-control"><p class="help-block">{{ help_supplier }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_local }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_local" value="{{ module_vm_catalog_local }}" class="form-control"><p class="help-block">{{ help_local }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_site_local }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_site_local" value="{{ module_vm_catalog_site_local }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_site_remote }}</label><div class="col-sm-4"><input type="text" name="module_vm_catalog_site_remote" value="{{ module_vm_catalog_site_remote }}" class="form-control"><p class="help-block">{{ help_site_names }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_days }}</label><div class="col-sm-2"><input type="number" min="1" max="60" name="module_vm_catalog_days" value="{{ module_vm_catalog_days }}" class="form-control"></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_markup }}</label><div class="col-sm-2"><input type="text" name="module_vm_catalog_markup" value="{{ module_vm_catalog_markup }}" class="form-control"></div><div class="col-sm-5"><p class="help-block">{{ help_markup }}</p></div></div>
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_round }}</label><div class="col-sm-3"><select name="module_vm_catalog_round" class="form-control"><option value="0"{% if module_vm_catalog_round == 0 %} selected{% endif %}>{{ text_round_0 }}</option><option value="2"{% if module_vm_catalog_round == 2 %} selected{% endif %}>{{ text_round_2 }}</option></select></div></div>
          <input type="hidden" name="module_vm_catalog_update_url" value="{{ module_vm_catalog_update_url }}">
          <div class="form-group"><label class="col-sm-3 control-label">{{ entry_file }}</label><div class="col-sm-5"><input type="file" name="file" accept=".xlsx,.csv" class="form-control"><p class="help-block">max {{ upload_max }}</p></div></div>
          <div class="form-group"><div class="col-sm-offset-3 col-sm-9">
            <button type="button" id="vm-imp-go" class="btn btn-primary"><i class="fa fa-upload"></i> {{ button_import }}</button>
            <button type="button" id="vm-imp-resume" class="btn btn-default"{% if not job or job.finished %} style="display:none"{% endif %}><i class="fa fa-play"></i> {{ button_resume }}</button>
          </div></div>
        </form>
        <div id="vm-imp-status" style="max-width:720px">
          {% if job and not job.finished %}<div class="alert alert-info">{{ text_imp_resume|format(job.done, job.total) }}</div>{% endif %}
        </div>
        <div class="progress" id="vm-imp-bar" style="display:none;max-width:720px"><div class="progress-bar progress-bar-striped active" style="width:0%"></div></div>

        {% if stats %}
        <h4 style="margin-top:20px">{{ text_stats }}</h4>
        <table class="table table-condensed table-bordered" style="max-width:720px">
          <tr><th>{{ column_supplier }}</th><th>{{ column_total }}</th><th>{{ column_local }}</th><th>{{ column_remote }}</th><th>{{ column_last }}</th></tr>
          {% for s in stats %}<tr><td>{{ s.supplier }}</td><td>{{ s.total }}</td><td>{{ s.local_cnt }}</td><td>{{ s.remote_cnt }}</td><td>{{ s.last }}</td></tr>{% endfor %}
        </table>
        {% endif %}
      </div>
    </div>

    <!-- categories -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-sitemap"></i> {{ text_cat_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_cat_help|format(cat_preset|length, cat_total) }}</p>
        <details style="margin-bottom:12px"><summary style="cursor:pointer">{{ text_cat_preview }}</summary>
          <div style="columns:3;column-gap:24px;margin-top:10px;font-size:12px">
          {% for root in cat_preset %}<div style="break-inside:avoid;margin-bottom:10px"><b>{{ root.name }}</b> <span class="text-muted">({{ root.children|length }})</span><br>{{ root.children|join(', ') }}</div>{% endfor %}
          </div>
        </details>
        <form action="{{ categories_action }}" method="post" style="display:inline">
          <button type="submit" class="btn btn-default" onclick="return confirm('{{ text_cat_confirm|e('js') }}');"><i class="fa fa-plus"></i> {{ button_cat_create }}</button>
        </form>
      </div>
    </div>

    <!-- updates -->
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-refresh"></i> {{ text_upd_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_version|format(version) }}</p>
        {% if update_info %}
        <div class="alert alert-info">{{ text_upd_available|format(update_info.version, update_info.current) }}{% if update_info.notes %}<br><small>{{ update_info.notes }}</small>{% endif %}</div>
        <form action="{{ update_action }}" method="post" style="display:inline"><button type="submit" class="btn btn-success"><i class="fa fa-download"></i> {{ button_update|format(update_info.version) }}</button></form>
        {% else %}
        <a href="{{ check_action }}" class="btn btn-default"><i class="fa fa-search"></i> {{ button_check }}</a>
        {% endif %}
        {% if backups %}
        <p style="margin-top:15px"><b>{{ text_backups }}</b></p>
        <table class="table table-condensed" style="max-width:520px">
          {% for b in backups %}<tr><td>v{{ b.version }}</td><td class="text-muted">{{ b.date }}</td><td class="text-right"><a href="{{ rollback }}&amp;backup={{ b.file }}" class="btn btn-warning btn-xs" onclick="return confirm('{{ text_confirm_rb|e('js') }}');"><i class="fa fa-undo"></i> {{ button_rollback }}</a></td></tr>{% endfor %}
        </table>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function ($) {
  var uploadUrl = '{{ upload_url|e('js') }}', stepUrl = '{{ step_url|e('js') }}';
  var T = {
    reading: '{{ text_reading|e('js') }}', progress: '{{ text_progress|e('js') }}',
    done: '{{ text_imp_done|e('js') }}', countOff: '{{ text_count_off|e('js') }}', guard: '{{ text_guard|e('js') }}', network: '{{ text_network|e('js') }}'
  };
  function fmt(s, a) { var i = 0; return s.replace(/%s/g, function () { return a[i++]; }); }
  function status(html, cls) { $('#vm-imp-status').html('<div class="alert alert-' + (cls || 'info') + '">' + html + '</div>'); }
  function bar(p) { $('#vm-imp-bar').show().find('.progress-bar').css('width', p + '%').text(p + '%'); }
  function lock(on) { $('#vm-imp-go, #vm-imp-resume').prop('disabled', on); }

  function step() {
    $.ajax({ url: stepUrl, type: 'post', dataType: 'json', timeout: 180000 }).done(function (j) {
      if (j.error) { lock(false); status(j.error, 'danger'); return; }
      bar(j.total ? Math.floor(j.done * 100 / j.total) : 100);
      if (j.finished) {
        lock(false); $('#vm-imp-resume').hide();
        $('#vm-imp-bar .progress-bar').removeClass('active');
        var s = j.stats;
        status(fmt(T.done, [s.created, s.updated, s.local, s.remote, s.skipped, s.hidden]) + (s.count_off ? '<br>' + T.countOff : '') + (s.guard ? '<br><b>' + fmt(T.guard, [s.guard]) + '</b>' : ''), s.guard ? 'warning' : 'success');
        return;
      }
      status(fmt(T.progress, [j.done, j.total]));
      step();
    }).fail(function () { lock(false); $('#vm-imp-resume').show(); status(T.network, 'warning'); });
  }

  $('#vm-imp-go').on('click', function () {
    var form = $('#vm-imp-form')[0];
    if (!form.file.files.length) { form.file.focus(); return; }
    lock(true); status(T.reading); bar(0);
    $.ajax({ url: uploadUrl, type: 'post', data: new FormData(form), processData: false, contentType: false, dataType: 'json', timeout: 600000 })
      .done(function (j) {
        if (j.error) { lock(false); status(j.error, 'danger'); return; }
        if (j.warning) { $('#vm-imp-status').after('<div class="alert alert-warning" style="max-width:720px">' + j.warning + '</div>'); }
        status(fmt(T.progress, [0, j.total])); step();
      })
      .fail(function () { lock(false); status(T.network, 'warning'); });
  });

  $('#vm-imp-resume').on('click', function () { lock(true); step(); });


  // ---- BM Parts
  $('#vm-bm-probe').on('click', function () {
    var b = $(this).prop('disabled', true), box = $('#vm-bm-result');
    box.html('<div class="alert alert-info">{{ text_bm_probing|e('js') }}</div>');
    $.getJSON('{{ bm_probe_url|e('js') }}', { q: $('#vm-bm-q').val() }).done(function (j) {
      if (j.error) { box.html('<div class="alert alert-danger">' + esc(j.error) + '</div>'); return; }
      var h = '<table class="table table-condensed table-bordered" style="font-size:12px"><tr><th style="width:28%">Що перевіряли</th><th>Код</th><th>Що повернуло</th></tr>';
      $.each(j.steps, function (i, r) {
        h += '<tr><td>' + esc(r.name) + '</td><td>' + esc(r.code) + '</td><td style="word-break:break-word">' + (r.error ? '<span class="text-danger">' + esc(r.error) + '</span> ' : '') + '<code style="white-space:pre-wrap">' + esc(r.shape) + '</code></td></tr>';
      });
      box.html(h + '</table>');
    }).fail(function (x) { box.html('<div class="alert alert-warning">{{ text_probe_fail|e('js') }}<br><small>' + esc((x.responseText || '').slice(0, 300)) + '</small></div>'); }).always(function () { b.prop('disabled', false); });
  });


  // ---- BM enrichment loop
  var enrichOn = false;
  function enrichStats(st) {
    var t = $('#vm-enrich-stats');
    t.find('[data-k=checked_total]').text(st.checked + ' / ' + st.total);
    t.find('[data-k=found]').text(st.found); t.find('[data-k=notfound]').text(st.notfound); t.find('[data-k=errors]').text(st.errors);
    t.find('[data-k=cars]').html(st.with_cars + ' <small class="text-muted">(' + st.models + ' {{ text_en_models|e('js') }})</small>');
    t.find('[data-k=with_analogs]').text(st.with_analogs); t.find('[data-k=images]').text(st.images);
  }
  function enrichStep() {
    if (!enrichOn) { return; }
    $('#vm-enrich-msg').text('{{ text_en_working|e('js') }}');
    $.ajax({ url: '{{ enrich_url|e('js') }}', dataType: 'json', timeout: 120000 }).done(function (j) {
      if (j.error) { enrichStop(esc(j.error)); return; }
      enrichStats(j.stats);
      var r = j.run;
      $('#vm-enrich-msg').text('+' + r.found + ' / ' + r.checked + ' (' + r.requests + ' req)');
      if (r.stopped === 'done') { enrichStop('{{ text_en_done|e('js') }}'); return; }
      if (r.stopped) { enrichStop(esc(r.stopped)); return; }
      setTimeout(enrichStep, 500);
    }).fail(function () { setTimeout(enrichStep, 5000); });
  }
  function enrichStop(msg) { enrichOn = false; $('#vm-enrich-go').show(); $('#vm-enrich-stop').hide(); $('#vm-enrich-msg').html(msg || ''); }
  $('#vm-enrich-go').on('click', function () { enrichOn = true; $(this).hide(); $('#vm-enrich-stop').show(); enrichStep(); });
  $('#vm-enrich-stop').on('click', function () { enrichStop('{{ text_en_stopped|e('js') }}'); });

  // ---- UTR
  var utrProbeUrl = '{{ utr_probe_url|e('js') }}', utrPriceUrl = '{{ utr_price_url|e('js') }}';
  function utrMsg(html, cls) { $('#vm-utr-result').html('<div class="alert alert-' + (cls || 'info') + '">' + html + '</div>'); }
  function esc(t) { return $('<div>').text(t == null ? '' : String(t)).html(); }

  $('#vm-utr-probe').on('click', function () {
    var b = $(this).prop('disabled', true);
    utrMsg('{{ text_utr_probing|e('js') }}');
    $.getJSON(utrProbeUrl).done(function (j) {
      if (j.error) { utrMsg(esc(j.error), 'danger'); return; }
      var h = '<p><b>{{ text_utr_login_ok|e('js') }}</b></p><table class="table table-condensed table-bordered"><tr><th>Артикул</th><th>Бренд</th><th>Пошук</th><th>Назва / категорія UTR</th><th>Складів</th><th>Застосовність</th><th>Аналоги</th><th>Інші поля</th></tr>';
      $.each(j.items, function (i, r) {
        h += '<tr><td>' + esc(r.article) + '</td><td>' + esc(r.brand) + '</td><td>' + esc(r.search) + '</td><td>' + esc(r.title) + '<br><small>' + esc(r.category) + '</small></td><td>' + esc(r.storages) + '</td><td>' + esc(r.applicability) + '</td><td>' + esc(r.analogs) + '</td><td><small>' + esc(r.extra) + '</small></td></tr>';
      });
      utrMsg(h + '</table><p class="text-muted">{{ text_utr_codes|e('js') }}</p>', 'info');
    }).fail(function (x) { utrMsg('{{ text_probe_fail|e('js') }}<br><small>' + esc((x.responseText || '').slice(0, 300)) + '</small>', 'warning'); }).always(function () { b.prop('disabled', false); });
  });

  $('#vm-utr-price').on('click', function () {
    var b = $(this).prop('disabled', true);
    utrMsg('{{ text_utr_requesting|e('js') }}');
    $.getJSON(utrPriceUrl + '&step=request').done(function (j) {
      if (j.error) { b.prop('disabled', false); utrMsg(esc(j.error), 'danger'); return; }
      var id = j.id, tries = 0;
      (function poll() {
        $.getJSON(utrPriceUrl + '&step=import&id=' + id, { _: Date.now() }).done(function (s) {
          if (s.error) { b.prop('disabled', false); utrMsg(esc(s.error), 'danger'); return; }
          if (s.status === 'started') {
            b.prop('disabled', false);
            utrMsg('{{ text_utr_downloaded|e('js') }}', 'success');
            $('html,body').animate({ scrollTop: $('#vm-imp-status').offset().top - 80 }, 300);
            lock(true); bar(0); status(fmt(T.progress, [0, s.total])); step();
            return;
          }
          if (s.status === 'error') { b.prop('disabled', false); utrMsg('{{ text_utr_price_error|e('js') }}', 'danger'); return; }
          utrMsg('{{ text_utr_waiting|e('js') }} (' + (++tries * 10) + ' с)');
          setTimeout(poll, 10000);
        }).fail(function () { setTimeout(poll, 15000); });
      })();
    }).fail(function () { b.prop('disabled', false); utrMsg(T.network, 'warning'); });
  });

})(jQuery);
//--></script>
{{ footer }}
