{{ header }}
<div id="product-product" class="container vm-product-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class = 'col-sm-6' %}{% elseif column_left or column_right %}{% set class = 'col-sm-9' %}{% else %}{% set class = 'col-sm-12' %}{% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="vm-pp-top">
        <div class="vm-pp-gallery vm-box">
          <div class="vm-stickers vm-pp-stickers">{% if vm_product.vm_hit %}<span class="vm-st vm-st-hit">{{ vm_t.text_hit }}</span>{% endif %}{% if vm_product.vm_new %}<span class="vm-st vm-st-new">{{ vm_t.text_new }}</span>{% endif %}{% if vm_product.vm_discount %}<span class="vm-st vm-st-sale">{{ vm_product.vm_discount }}</span>{% endif %}</div>
          {% if thumb or images %}
          <ul class="thumbnails">
            {% if thumb %}
            <li><a class="thumbnail" href="{{ popup }}" title="{{ heading_title }}"><img src="{{ thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></a></li>
            {% endif %}
            {% if images %}
            {% for image in images %}
            <li class="image-additional"><a class="thumbnail" href="{{ image.popup }}" title="{{ heading_title }}"> <img src="{{ image.thumb }}" title="{{ heading_title }}" alt="{{ heading_title }}" /></a></li>
            {% endfor %}
            {% endif %}
          </ul>
          {% endif %}
        </div>
        <div class="vm-pp-info">
          <div class="vm-box vm-pp-buy">
            <h1>{{ heading_title }}</h1>
            <ul class="vm-pp-meta list-unstyled">
              {% if manufacturer %}<li>{{ text_manufacturer }} <a href="{{ manufacturers }}"><b>{{ manufacturer }}</b></a></li>{% endif %}
              <li>{{ text_model }} <b>{{ model }}</b></li>
              {% if reward %}<li>{{ text_reward }} {{ reward }}</li>{% endif %}
            </ul>
            {% if vm_product.vm_fit %}<div class="vm-pp-fit"><i class="fa fa-check-circle"></i> {{ vm_t.text_car_fits_yours }}: <b>{{ vm_product.vm_fit }}</b></div>
            {% elseif vm_nofit %}<div class="vm-pp-nofit"><i class="fa fa-exclamation-triangle"></i> {{ vm_t.text_car_nofit|format(vm_nofit) }}</div>{% endif %}
            <div class="vm-pp-pricebox">
              {% if price %}
              <div class="vm-pp-price">{% if not special %}<b>{{ price }}</b>{% else %}<s>{{ price }}</s> <b class="vm-price-new">{{ special }}</b>{% endif %}</div>
              {% endif %}
              {% if vm_product.vm_stock_lines %}
              <div class="vm-wh">{% for w in vm_product.vm_stock_lines %}<div class="vm-wh-line vm-wh-{{ w.class }}"><span class="vm-stock vm-stock-{{ w.class }}">{{ w.text }}</span> <small>{{ w.note }}</small></div>{% endfor %}</div>
              {% else %}
              <span class="vm-stock vm-stock-{{ vm_product.vm_stock_class ? vm_product.vm_stock_class : 'in' }}">{{ stock }}</span>
              {% endif %}
            </div>
            {% if vm_an_alert %}<a href="#tab-vm-analogs" class="vm-pp-analert" onclick="$('a[href=\'#tab-vm-analogs\']').tab('show');document.getElementById('tab-vm-analogs').scrollIntoView({behavior:'smooth',block:'start'});return false;"><i class="fa fa-exchange"></i> <span>{{ vm_t.text_an_alert|format(vm_analogs|length) }}{% if vm_analogs_min %} {{ vm_t.text_an_from|format(vm_analogs_min) }}{% endif %}</span> <b>{{ vm_t.text_an_show }} &rarr;</b></a>{% endif %}
            {% if price %}
            <ul class="list-unstyled vm-pp-extra">
              {% if tax %}<li>{{ text_tax }} {{ tax }}</li>{% endif %}
              {% if points %}<li>{{ text_points }} {{ points }}</li>{% endif %}
              {% for discount in discounts %}<li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>{% endfor %}
            </ul>
            {% endif %}
            <div id="product"> {% if options %}
            <hr>
            <h3>{{ text_option }}</h3>
            {% for option in options %}
            {% if option.type == 'select' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for option_value in option.product_option_value %}
                <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                {% if option_value.price %}
                ({{ option_value.price_prefix }}{{ option_value.price }})
                {% endif %} </option>
                {% endfor %}
              </select>
            </div>
            {% endif %}
            {% if option.type == 'radio' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                <div class="radio">
                  <label>
                    <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}" />
                    {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}                  
                    {{ option_value.name }}
                    {% if option_value.price %}
                    ({{ option_value.price_prefix }}{{ option_value.price }})
                    {% endif %} </label>
                </div>
                {% endfor %} </div>
            </div>
            {% endif %}
            {% if option.type == 'checkbox' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}" />
                    {% if option_value.image %} <img src="{{ option_value.image }}" alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}" class="img-thumbnail" /> {% endif %}
                    {{ option_value.name }}
                    {% if option_value.price %}
                    ({{ option_value.price_prefix }}{{ option_value.price }})
                    {% endif %} </label>
                </div>
                {% endfor %} </div>
            </div>
            {% endif %}
            {% if option.type == 'text' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control" />
            </div>
            {% endif %}
            {% if option.type == 'textarea' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <textarea name="option[{{ option.product_option_id }}]" rows="5" placeholder="{{ option.name }}" id="input-option{{ option.product_option_id }}" class="form-control">{{ option.value }}</textarea>
            </div>
            {% endif %}
            {% if option.type == 'file' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label">{{ option.name }}</label>
              <button type="button" id="button-upload{{ option.product_option_id }}" data-loading-text="{{ text_loading }}" class="btn btn-default btn-block"><i class="fa fa-upload"></i> {{ button_upload }}</button>
              <input type="hidden" name="option[{{ option.product_option_id }}]" value="" id="input-option{{ option.product_option_id }}" />
            </div>
            {% endif %}
            {% if option.type == 'date' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group date">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% if option.type == 'datetime' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group datetime">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% if option.type == 'time' %}
            <div class="form-group{% if option.required %} required {% endif %}">
              <label class="control-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
              <div class="input-group time">
                <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" data-date-format="HH:mm" id="input-option{{ option.product_option_id }}" class="form-control" />
                <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span></div>
            </div>
            {% endif %}
            {% endfor %}
            {% endif %}
            {% if recurrings %}
            <hr>
            <h3>{{ text_payment_recurring }}</h3>
            <div class="form-group required">
              <select name="recurring_id" class="form-control">
                <option value="">{{ text_select }}</option>
                {% for recurring in recurrings %}
                <option value="{{ recurring.recurring_id }}">{{ recurring.name }}</option>
                {% endfor %}
              </select>
              <div class="help-block" id="recurring-description"></div>
            </div>
            {% endif %}
            <div class="form-group">
              <label class="control-label" for="input-quantity">{{ entry_qty }}</label>
              <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control" />
              <input type="hidden" name="product_id" value="{{ product_id }}" />
              <br/>
              <button type="button" id="button-cart" data-loading-text="{{ text_loading }}" class="vm-buy vm-buy-lg">{{ button_cart }}</button>
              {% if vm_quick_url %}<button type="button" class="vm-quick-btn" data-toggle="modal" data-target="#vm-quick"><i class="fa fa-bolt"></i> {{ vm_t.text_quick_btn }}</button>{% endif %}
            </div>
            {% if minimum > 1 %}
            <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_minimum }}</div>
            {% endif %}</div>
            <div class="vm-pp-actions">
              <button type="button" class="vm-link-btn" onclick="wishlist.add('{{ product_id }}');"><i class="fa fa-heart-o"></i> {{ button_wishlist }}</button>
              <button type="button" class="vm-link-btn" onclick="compare.add('{{ product_id }}');"><i class="fa fa-exchange"></i> {{ button_compare }}</button>
            </div>
            {% if review_status %}
          <div class="rating">
            <p>{% for i in 1..5 %}
              {% if rating < i %}<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-1x"></i></span>{% else %}<span class="fa fa-stack"><i class="fa fa-star fa-stack-1x"></i><i class="fa fa-star-o fa-stack-1x"></i></span>{% endif %}
              {% endfor %} <a href="" onclick="$('a[href=\'#tab-review\']').trigger('click'); return false;">{{ reviews }}</a> / <a href="" onclick="$('a[href=\'#tab-review\']').trigger('click'); return false;">{{ text_write }}</a></p>
          </div>
          {% endif %}
          </div>
          <div class="vm-box vm-pp-service">
            <div><i class="fa fa-truck"></i> {{ vm_t.text_delivery_box }}</div>
            <div><i class="fa fa-credit-card"></i> {{ vm_t.text_payment_box }}</div>
            <div><i class="fa fa-undo"></i> {{ vm_t.text_return_box }}</div>
          </div>
        </div>
      </div>
      <div class="vm-box vm-pp-tabs">
          <ul class="nav nav-tabs vm-tabs">
            <li class="active"><a href="#tab-vm-chars" data-toggle="tab"><i class="fa fa-list-ul"></i> {{ vm_t.text_tab_chars }}</a></li>
            <li><a href="#tab-description" data-toggle="tab"><i class="fa fa-file-text-o"></i> {{ vm_t.text_tab_desc }}</a></li>
            <li><a href="#tab-vm-compat" data-toggle="tab"><i class="fa fa-car"></i> {{ vm_t.text_compat }}{% if vm_compat %} ({{ vm_compat|length }}){% elseif vm_fits %} ({{ vm_fits|length }}){% endif %}</a></li>
            <li><a href="#tab-vm-oe" data-toggle="tab"><i class="fa fa-hashtag"></i> {{ vm_t.text_tab_oe }}{% if vm_oe %} ({{ vm_oe|length }}){% endif %}</a></li>
            <li><a href="#tab-vm-analogs" data-toggle="tab"><i class="fa fa-exchange"></i> {{ vm_t.text_tab_analogs }}{% if vm_analogs %} ({{ vm_analogs|length }}){% endif %}</a></li>
            {% if vm_images_all|length > 1 %}<li><a href="#tab-vm-photos" data-toggle="tab"><i class="fa fa-picture-o"></i> {{ vm_t.text_tab_photos }} ({{ vm_images_all|length }})</a></li>{% endif %}
            {% if review_status %}
            <li><a href="#tab-review" data-toggle="tab"><i class="fa fa-star-o"></i> {{ tab_review }}</a></li>
            {% endif %}
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-vm-chars">
              <table class="vm-chars">
                {% for c in vm_chars %}<tr><th>{{ c[0] }}</th><td>{{ c[1] }}</td></tr>{% endfor %}
                {% for attribute_group in attribute_groups %}{% for attribute in attribute_group.attribute %}<tr><th>{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>{% endfor %}{% endfor %}
              </table>
            </div>
            <div class="tab-pane" id="tab-description">
              {% if description|striptags|trim %}<div class="vm-article">{{ description }}</div>{% else %}<p>{{ vm_t.text_desc_auto|format(heading_title, manufacturer ? manufacturer : '—', model) }}</p>{% endif %}
            </div>
            <div class="tab-pane" id="tab-vm-compat">
              {% if vm_compat %}
              <div class="vm-cmp" id="vm-cmp">
                <div class="vm-cmp-col"><div class="vm-cmp-head">{{ vm_t.text_cmp_make }}</div><ul class="vm-cmp-list" data-level="make">{% for mk in vm_compat %}<li><button type="button" data-i="{{ loop.index0 }}"{% if loop.first %} class="is-active"{% endif %}>{{ mk.name }}</button></li>{% endfor %}</ul></div>
                <div class="vm-cmp-col"><div class="vm-cmp-head">{{ vm_t.text_cmp_model }}</div><ul class="vm-cmp-list" data-level="model"></ul></div>
                <div class="vm-cmp-col"><div class="vm-cmp-head">{{ vm_t.text_cmp_mod }}</div><ul class="vm-cmp-list" data-level="mod"><li class="vm-cmp-hint">{{ vm_t.text_cmp_pick }}</li></ul></div>
              </div>
              <script type="application/json" id="vm-cmp-data">{{ vm_compat|json_encode|replace({'</': '<\\/'}) }}</script>
              <script>
              (function(){
                var box=document.getElementById('vm-cmp');if(!box)return;
                var data=JSON.parse(document.getElementById('vm-cmp-data').textContent);
                var L=box.querySelectorAll('.vm-cmp-list'),pick='{{ vm_t.text_cmp_pick|e('js') }}',none='{{ vm_t.text_cmp_none|e('js') }}';
                function esc(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML;}
                function models(i){
                  var mk=data[i]||{models:[]};
                  L[1].innerHTML=mk.models.map(function(m,j){return '<li><button type="button" data-j="'+j+'">'+esc(m.name)+'</button></li>';}).join('');
                  L[2].innerHTML='<li class="vm-cmp-hint">'+pick+'</li>';
                  [].forEach.call(L[1].querySelectorAll('button'),function(b){b.onclick=function(){
                    [].forEach.call(L[1].querySelectorAll('button'),function(x){x.classList.remove('is-active');});b.classList.add('is-active');
                    var en=mk.models[+b.getAttribute('data-j')].engines||[];
                    L[2].innerHTML=en.length?en.map(function(e){return '<li class="vm-cmp-eng">'+esc(e)+'</li>';}).join(''):'<li class="vm-cmp-hint">'+none+'</li>';
                  };});
                }
                [].forEach.call(L[0].querySelectorAll('button'),function(b){b.onclick=function(){
                  [].forEach.call(L[0].querySelectorAll('button'),function(x){x.classList.remove('is-active');});b.classList.add('is-active');models(+b.getAttribute('data-i'));
                };});
                models(0);
              })();
              </script>
              {% elseif vm_fits %}
              <div class="table-responsive"><table class="table vm-compat-table">
                <thead><tr><th>{{ vm_t.text_make }}</th><th>{{ vm_t.text_model_car }}</th><th>{{ vm_t.text_years }}</th></tr></thead>
                <tbody>{% for f in vm_fits %}<tr><td><b>{{ f.make }}</b></td><td>{{ f.model }}</td><td>{{ f.years }}</td></tr>{% endfor %}</tbody>
              </table></div>
              {% else %}<p class="text-muted">{{ vm_t.text_cmp_empty }}</p>{% endif %}
            </div>
            <div class="tab-pane" id="tab-vm-oe">
              {% if vm_oe %}
              <p class="text-muted">{{ vm_t.text_oe_help }}</p>
              <div class="vm-oe">{% for o in vm_oe %}<a href="{{ o.href }}">{{ o.oe }}</a>{% endfor %}</div>
              {% else %}<p class="text-muted">{{ vm_t.text_oe_empty }}</p>{% endif %}
            </div>
            <div class="tab-pane" id="tab-vm-analogs">
              {% if vm_analogs %}
              <p class="text-muted">{{ vm_t.text_an_help }}</p>
              <div class="vm-an">{% for a in vm_analogs %}
                <div class="vm-an-row">
                  <a class="vm-an-img" href="{{ a.href }}"><img src="{{ a.thumb }}" alt="{{ a.name }}" loading="lazy"></a>
                  <div class="vm-an-info"><a href="{{ a.href }}">{{ a.name }}</a>{% if a.vm_model or a.vm_via %}<div class="vm-an-meta">{% if a.vm_model %}<span>{{ a.vm_model }}</span>{% endif %}{% if a.vm_via %}<em class="vm-an-via">{{ a.vm_via }}</em>{% endif %}</div>{% endif %}{% if a.vm_stock %}<div class="vm-stock vm-stock-{{ a.vm_stock_class }}">{{ a.vm_stock }}</div>{% endif %}</div>
                  <div class="vm-an-price">{% if a.special %}<s>{{ a.price }}</s> <b>{{ a.special }}</b>{% else %}<b>{{ a.price }}</b>{% endif %}</div>
                  <button type="button" class="vm-an-buy" onclick="cart.add('{{ a.product_id }}', '{{ a.minimum }}');" aria-label="{{ vm_t.text_buy }}"><i class="fa fa-shopping-cart"></i></button>
                </div>{% endfor %}
              </div>
              {% else %}<p class="text-muted">{{ vm_t.text_an_empty }}</p>{% endif %}
              {% if vm_analogs_more %}<p class="vm-an-more">{{ vm_t.text_an_more|format(vm_analogs_more) }}</p>{% endif %}
            </div>
            {% if vm_images_all|length > 1 %}
            <div class="tab-pane" id="tab-vm-photos">
              <div class="vm-ph">{% for im in vm_images_all %}<a href="{{ im.popup }}" class="vm-ph-item" target="_blank" rel="noopener"><img src="{{ im.popup }}" alt="{{ heading_title }}" loading="lazy"></a>{% endfor %}</div>
            </div>
            {% endif %}
            {% if review_status %}
            <div class="tab-pane" id="tab-review">
              <form class="form-horizontal" id="form-review">
                <div id="review"></div>
                <h2>{{ text_write }}</h2>
                {% if review_guest %}
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label" for="input-name">{{ entry_name }}</label>
                    <input type="text" name="name" value="{{ customer_name }}" id="input-name" class="form-control" />
                  </div>
                </div>
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label" for="input-review">{{ entry_review }}</label>
                    <textarea name="text" rows="5" id="input-review" class="form-control"></textarea>
                    <div class="help-block">{{ text_note }}</div>
                  </div>
                </div>
                <div class="form-group required">
                  <div class="col-sm-12">
                    <label class="control-label">{{ entry_rating }}</label>
                    &nbsp;&nbsp;&nbsp; {{ entry_bad }}&nbsp;
                    <input type="radio" name="rating" value="1" />
                    &nbsp;
                    <input type="radio" name="rating" value="2" />
                    &nbsp;
                    <input type="radio" name="rating" value="3" />
                    &nbsp;
                    <input type="radio" name="rating" value="4" />
                    &nbsp;
                    <input type="radio" name="rating" value="5" />
                    &nbsp;{{ entry_good }}</div>
                </div>
                {{ captcha }}
                <div class="buttons clearfix">
                  <div class="pull-right">
                    <button type="button" id="button-review" data-loading-text="{{ text_loading }}" class="btn btn-primary">{{ button_continue }}</button>
                  </div>
                </div>
                {% else %}
                {{ text_login }}
                {% endif %}
              </form>
            </div>
            {% endif %}</div>
      </div>
      {% if products %}
      <h2 class="vm-h2">{{ text_related }}</h2>
      <div class="vm-grid">
      {% for product in products %}
<div class="vm-card">
  <div class="vm-stickers">{% if product.vm_hit %}<span class="vm-st vm-st-hit">{{ vm_t.text_hit }}</span>{% endif %}{% if product.vm_new %}<span class="vm-st vm-st-new">{{ vm_t.text_new }}</span>{% endif %}{% if product.vm_discount %}<span class="vm-st vm-st-sale">{{ product.vm_discount }}</span>{% endif %}</div>
  <button type="button" class="vm-fav" title="{{ button_wishlist }}" aria-label="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
  <a class="vm-card-img" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" /></a>
  {% if product.vm_stock %}<div class="vm-stock vm-stock-{{ product.vm_stock_class }}">{{ product.vm_stock }}</div>{% endif %}
  <a class="vm-card-name" href="{{ product.href }}">{{ product.name }}</a>
  {% if product.vm_fit %}<div class="vm-fit">{{ vm_t.text_fits }}: {{ product.vm_fit }}</div>{% endif %}
  {% if product.vm_model %}<div class="vm-code">{{ vm_t.text_code }}: {{ product.vm_model }}</div>{% endif %}
  <div class="vm-card-bottom">
    {% if product.price %}<div class="vm-price">{% if product.special %}<s>{{ product.price }}</s><b class="vm-price-new">{{ product.special }}</b>{% else %}<b>{{ product.price }}</b>{% endif %}</div>{% endif %}
    <button type="button" class="vm-buy" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i> {{ vm_t.text_buy }}</button>
  </div>
</div>
      {% endfor %}
      </div>
      {% endif %}
      {% if tags %}
        <p>{{ text_tags }}
        {% for i in 0..tags|length - 1 %}
        {% if i < (tags|length - 1) %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>,
        {% else %} <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a> {% endif %}
        {% endfor %} </p>
        {% endif %}
      
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{% if price %}
<div class="vm-buybar" id="vm-buybar" aria-hidden="true">
  <div class="vm-buybar-price">{% if special %}<s>{{ price }}</s><b class="vm-price-new">{{ special }}</b>{% else %}<b>{{ price }}</b>{% endif %}</div>
  <button type="button" class="vm-buy" onclick="document.getElementById('button-cart').click();"><i class="fa fa-shopping-cart"></i> {{ vm_t.text_buy }}</button>
</div>
<script>
(function(){
  var btn=document.getElementById('button-cart'),bar=document.getElementById('vm-buybar');
  if(!btn||!bar||!('IntersectionObserver' in window))return;
  new IntersectionObserver(function(es){var v=es[0].isIntersecting;bar.classList.toggle('is-visible',!v);document.body.classList.toggle('vm-has-buybar',!v);},{threshold:0}).observe(btn);
})();
</script>
{% endif %}
<script type="text/javascript"><!--
$('select[name=\'recurring_id\'], input[name="quantity"]').change(function(){
	$.ajax({
		url: 'index.php?route=product/product/getRecurringDescription',
		type: 'post',
		data: $('input[name=\'product_id\'], input[name=\'quantity\'], select[name=\'recurring_id\']'),
		dataType: 'json',
		beforeSend: function() {
			$('#recurring-description').html('');
		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();

			if (json['success']) {
				$('#recurring-description').html(json['success']);
			}
		}
	});
});
//--></script> 
<script type="text/javascript"><!--
$('#button-cart').on('click', function() {
	$.ajax({
		url: 'index.php?route=checkout/cart/add',
		type: 'post',
		data: $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea'),
		dataType: 'json',
		beforeSend: function() {
			$('#button-cart').button('loading');
		},
		complete: function() {
			$('#button-cart').button('reset');
		},
		success: function(json) {
			$('.alert-dismissible, .text-danger').remove();
			$('.form-group').removeClass('has-error');

			if (json['error']) {
				if (json['error']['option']) {
					for (i in json['error']['option']) {
						var element = $('#input-option' + i.replace('_', '-'));

						if (element.parent().hasClass('input-group')) {
							element.parent().after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						} else {
							element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
						}
					}
				}

				if (json['error']['recurring']) {
					$('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
				}

				// Highlight any found errors
				$('.text-danger').parent().addClass('has-error');
			}

			if (json['success']) {
				if (window.vmCartPopup) {
					var q = parseInt($('#product input[name=\'quantity\']').val(), 10) || 1;
					vmCartPopup({name: $.trim($('h1').first().text()), img: $('.thumbnails img').first().attr('src') || '', price: $.trim($('.vm-pp-price b').last().text())}, q);
				} else {
					$('.breadcrumb').after('<div class="alert alert-success alert-dismissible">' + json['success'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
					$('html, body').animate({ scrollTop: 0 }, 'slow');
				}

				if (window.vmCartRefresh) { vmCartRefresh(); } else { $('#cart > ul').load('index.php?route=common/cart/info ul li'); }
			}
		},
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
	});
});
//--></script> 
<script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});

$('.datetime').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: true,
	pickTime: true
});

$('.time').datetimepicker({
	language: '{{ datepicker }}',
	pickDate: false
});

$('button[id^=\'button-upload\']').on('click', function() {
	var node = this;

	$('#form-upload').remove();

	$('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

	$('#form-upload input[name=\'file\']').trigger('click');

	if (typeof timer != 'undefined') {
    	clearInterval(timer);
	}

	timer = setInterval(function() {
		if ($('#form-upload input[name=\'file\']').val() != '') {
			clearInterval(timer);

			$.ajax({
				url: 'index.php?route=tool/upload',
				type: 'post',
				dataType: 'json',
				data: new FormData($('#form-upload')[0]),
				cache: false,
				contentType: false,
				processData: false,
				beforeSend: function() {
					$(node).button('loading');
				},
				complete: function() {
					$(node).button('reset');
				},
				success: function(json) {
					$('.text-danger').remove();

					if (json['error']) {
						$(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
					}

					if (json['success']) {
						alert(json['success']);

						$(node).parent().find('input').val(json['code']);
					}
				},
				error: function(xhr, ajaxOptions, thrownError) {
					alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
				}
			});
		}
	}, 500);
});
//--></script> 
<script type="text/javascript"><!--
$('#review').delegate('.pagination a', 'click', function(e) {
    e.preventDefault();

    $('#review').fadeOut('slow');

    $('#review').load(this.href);

    $('#review').fadeIn('slow');
});

$('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

$('#button-review').on('click', function() {
	$.ajax({
		url: 'index.php?route=product/product/write&product_id={{ product_id }}',
		type: 'post',
		dataType: 'json',
		data: $("#form-review").serialize(),
		beforeSend: function() {
			$('#button-review').button('loading');
		},
		complete: function() {
			$('#button-review').button('reset');
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#review').after('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
			}

			if (json['success']) {
				$('#review').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + '</div>');

				$('input[name=\'name\']').val('');
				$('textarea[name=\'text\']').val('');
				$('input[name=\'rating\']:checked').prop('checked', false);
			}
		}
	});
});

$(document).ready(function() {
	$('.thumbnails').magnificPopup({
		type:'image',
		delegate: 'a',
		gallery: {
			enabled: true
		}
	});
});
//--></script> 
{% if vm_quick_url %}
<div class="modal fade vm-lead-modal" id="vm-quick" tabindex="-1" role="dialog" aria-labelledby="vm-quick-h">
  <div class="modal-dialog modal-sm" role="document"><div class="modal-content">
    <form id="vm-quick-form" action="{{ vm_quick_url }}" method="post" novalidate>
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="×"><span aria-hidden="true">&times;</span></button><h4 class="modal-title" id="vm-quick-h">{{ vm_t.text_quick_title }}</h4></div>
      <div class="modal-body">
        <p class="vm-lead-prod"><b>{{ heading_title }}</b><br><span class="text-muted">{{ model }}</span> · {% if special %}{{ special }}{% else %}{{ price }}{% endif %}</p>
        <p class="text-muted small">{{ vm_t.text_quick_lead }}</p>
        <input type="hidden" name="product_id" value="{{ product_id }}"><input type="hidden" name="token" value="{{ vm_lead_token }}">
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" class="vm-hp" aria-hidden="true">
        <div class="form-group"><input type="tel" name="phone" class="form-control input-lg" placeholder="{{ vm_t.text_lead_phone_ph }}" autocomplete="tel" required></div>
        <div class="form-group"><input type="text" name="name" class="form-control" placeholder="{{ vm_t.text_lead_name_ph }}" autocomplete="name" maxlength="64"></div>
        <div class="vm-lead-msg"></div>
        <p class="help-block small">{{ vm_t.text_lead_privacy }}</p>
      </div>
      <div class="modal-footer"><button type="submit" class="vm-buy vm-buy-lg btn-block">{{ vm_t.text_quick_send }}</button></div>
    </form>
  </div></div>
</div>
<script>
$('#vm-quick').on('shown.bs.modal', function () { $(this).find('[name=phone]').trigger('focus'); });
$('#vm-quick-form').on('submit', function (e) {
  e.preventDefault();
  var f = $(this), b = f.find('[type=submit]'), m = f.find('.vm-lead-msg');
  var d = f.serializeArray(); d.push({name: 'quantity', value: $('#input-quantity').val() || 1});
  b.prop('disabled', true); m.removeClass('text-danger text-success').text('');
  $.post(f.attr('action'), $.param(d), null, 'json').done(function (r) {
    if (r.success) { f.find('.modal-body').html('<p class="vm-lead-ok"><i class="fa fa-check-circle"></i> ' + vmLeadEsc(r.success) + '</p>'); f.find('.modal-footer').remove(); }
    else { m.addClass('text-danger').text(r.error || ''); b.prop('disabled', false); }
  }).fail(function () { m.addClass('text-danger').text('{{ vm_t.text_lead_expired|e('js') }}'); b.prop('disabled', false); });
});
function vmLeadEsc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
</script>
{% endif %}
