{{ header }}
<div id="common-home" class="container vm-home-wrap{% if vm_hero %} vm-has-hero{% endif %}">
  <div class="vm-home-top">
    <aside class="vm-home-catalog">
      <div class="vm-home-catalog-title"><i class="fa fa-bars"></i> {{ vm_t.text_catalog }}</div>
      <ul class="vm-catalog-list vm-catalog-static">
        {% for cat in vm_menu %}
        <li class="{% if cat.children %}has-children{% endif %}">
          <a href="{{ cat.href }}"><span class="vm-cat-ico"><i class="fa {{ cat.icon }}"></i></span><span class="vm-cat-name">{{ cat.name }}</span>{% if cat.children %}<i class="fa fa-angle-right"></i>{% endif %}</a>
          {% if cat.children %}
          <div class="vm-flyout">
            <a class="vm-flyout-title" href="{{ cat.href }}">{{ cat.name }}</a>
            <ul>{% for child in cat.children %}<li><a href="{{ child.href }}">{{ child.name }}</a></li>{% endfor %}</ul>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {{ column_left }}
    </aside>
    <div class="vm-home-main">
      {% for blk in vm_top_blocks %}
      {% if blk == 'hero' %}
      {% if vm_hero %}
      <div class="vm-hero" data-vm-hero>
        {% for s in vm_hero %}
        <div class="vm-hero-slide{% if loop.first %} is-active{% endif %}">
          <div class="vm-hero-text">
            {% if s.badge %}<span class="vm-hero-badge">{{ s.badge }}</span>{% endif %}
            {% if loop.first %}<h1 class="vm-hero-title">{{ s.title }}</h1>{% else %}<div class="vm-hero-title">{{ s.title }}</div>{% endif %}
            {% if s.text %}<p>{{ s.text }}</p>{% endif %}
            <div class="vm-hero-cta"><a class="vm-hero-btn" href="{{ s.link }}">{{ s.button }}</a>{% if s.price %}<span class="vm-hero-price">{{ s.price }}</span>{% endif %}</div>
          </div>
          <div class="vm-hero-media{% if not s.image %} vm-hero-art{% endif %}">{% if s.image %}<img src="{{ s.image }}" alt="{{ s.badge }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}">{% else %}<i class="fa fa-car"></i>{% if vm_t.text_hero_chip1 %}<span class="vm-hero-chip vm-hc1"><i class="fa fa-map-marker"></i> {{ vm_t.text_hero_chip1 }}</span>{% endif %}{% if vm_t.text_hero_chip2 %}<span class="vm-hero-chip vm-hc2"><i class="fa fa-barcode"></i> {{ vm_t.text_hero_chip2 }}</span>{% endif %}{% if vm_t.text_hero_chip3 %}<span class="vm-hero-chip vm-hc3"><i class="fa fa-truck"></i> {{ vm_t.text_hero_chip3 }}</span>{% endif %}{% endif %}</div>
        </div>
        {% endfor %}
        {% if vm_hero|length > 1 %}<div class="vm-hero-dots">{% for s in vm_hero %}<button type="button" class="{% if loop.first %}is-active{% endif %}" aria-label="{{ loop.index }}"></button>{% endfor %}</div>{% endif %}
      </div>
      {% endif %}
      {% elseif blk == 'modules' %}
      {{ content_top }}
      {% elseif blk == 'carbar' %}
      {{ vm_carbar_html }}
      {% elseif blk == 'benefits' %}
  {% if vm.benefits %}
      <div class="vm-benefits">
        {% for b in vm.benefits %}
        <div class="vm-benefit"><span class="vm-benefit-ico"><i class="fa fa-check"></i></span><span><b>{{ b.title }}</b><br><small>{{ b.text }}</small></span></div>
        {% endfor %}
      </div>
      {% endif %}
      {% endif %}
      {% endfor %}
    </div>
  </div>

  {% for blk in vm_blocks %}
  {% if blk == 'hits' %}
  {% if vm_hits %}
  <section class="vm-hits" data-vm-tabs>
    <div class="vm-sec-head"><h2 class="vm-h2">{{ vm_t.text_hits }}</h2>
      {% if vm_hit_tabs %}<div class="vm-tabs-pills"><button type="button" class="is-active" data-cat="">{{ vm_t.text_all_short }}</button>{% for tab in vm_hit_tabs %}<button type="button" data-cat="c{{ tab.id }}">{{ tab.name }}</button>{% endfor %}</div>{% endif %}
    </div>
    <div class="vm-grid vm-grid-5">
      {% for product in vm_hits %}
      <div class="vm-card{{ product.vm_cats }}">
  <div class="vm-stickers">{% if product.vm_hit %}<span class="vm-st vm-st-hit">{{ vm_t.text_hit }}</span>{% endif %}{% if product.vm_new %}<span class="vm-st vm-st-new">{{ vm_t.text_new }}</span>{% endif %}{% if product.vm_discount %}<span class="vm-st vm-st-sale">{{ product.vm_discount }}</span>{% endif %}</div>
  <button type="button" class="vm-fav" title="{{ vm_t.text_wishlist }}" aria-label="{{ vm_t.text_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart-o"></i></button>
  <a class="vm-card-img" href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" loading="lazy" /></a>
  {% if product.vm_stock %}<div class="vm-stock vm-stock-{{ product.vm_stock_class }}">{{ product.vm_stock }}</div>{% endif %}
  <a class="vm-card-name" href="{{ product.href }}">{{ product.name }}</a>
  {% if product.vm_fit %}<div class="vm-fit">{{ vm_t.text_fits }}: {{ product.vm_fit }}</div>{% endif %}
  {% if product.vm_model %}<div class="vm-code">{{ vm_t.text_code }}: {{ product.vm_model }}</div>{% endif %}
  <div class="vm-card-bottom">
    {% if product.price %}<div class="vm-price">{% if product.special %}<s>{{ product.price }}</s><b class="vm-price-new">{{ product.special }}</b>{% else %}<b>{{ product.price }}</b>{% endif %}</div>{% endif %}
    <button type="button" class="vm-buy" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i> {{ vm_t.text_buy }}</button>
  </div>
</div>
      {% endfor %}
    </div>
  </section>
  {% endif %}
  {% elseif blk == 'modules' %}
  {{ content_bottom }}
  {% elseif blk == 'promos' %}
  {% if vm_promos %}
  <div class="vm-promos">
    {% for pr in vm_promos %}<a class="vm-promo vm-promo-{{ pr.tone }}" href="{{ pr.href }}">{% if pr.image %}<img class="vm-promo-img" src="{{ pr.image }}" alt="{{ pr.name }}" loading="lazy">{% else %}<span class="vm-promo-ico"><i class="fa {{ pr.icon }}"></i></span>{% endif %}<span><b>{{ pr.name }}</b><small>{{ pr.text }}</small></span><em>{{ vm_t.text_promo_go }} →</em></a>{% endfor %}
  </div>
  {% endif %}
  {% elseif blk == 'wall' %}
  {% if vm_wall %}
  <h2 class="vm-h2">{{ vm_t.text_popular_cats }}</h2>
  <div class="vm-wall">
    {% for cat in vm_wall %}
    <a href="{{ cat.href }}" class="vm-wall-item">{% if cat.image %}<img src="{{ cat.image }}" alt="{{ cat.name }}" loading="lazy">{% else %}<span class="vm-wall-ico"><i class="fa {{ cat.icon }}"></i></span>{% endif %}<span>{{ cat.name }}</span><small>{{ cat.count }}</small></a>
    {% endfor %}
  </div>
  {% endif %}
  {% elseif blk == 'makes' %}
  {% if vm_makes %}
  <h2 class="vm-h2">{{ vm_t.text_by_make }}</h2>
  <div class="vm-makes">
    {% for m in vm_makes %}<a href="{{ m.href }}" class="vm-make"><span>{{ m.letter }}</span><b>{{ m.name }}</b><small>{{ m.count }}</small></a>{% endfor %}
  </div>
  {% endif %}
  {% elseif blk == 'seo' %}
  {% if vm_seo_text %}<section class="vm-seo-text">{{ vm_seo_text }}</section>{% endif %}
  {% endif %}
  {% endfor %}
  {{ column_right }}
</div>
{{ footer }}
